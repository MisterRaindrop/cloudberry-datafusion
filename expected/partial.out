SET optimizer = off;
-- GPORCA's Shared Scan (a CTE read twice, a ROLLUP): the slice of its
-- Sequence runs in DataFusion, which reads the Sequence's last input;
-- PostgreSQL first runs the producer, as the Sequence would, and the
-- producer reads its input, run in DataFusion below it, once into the
-- store its readers share, in other slices (the first) or its own (the
-- second).  A reader stays on PostgreSQL, and DataFusion pulls its rows
-- for what computes on them (the join in the second), or for a Motion
-- carrying batches (the first's and the third's readers, right below
-- their Motions in the third).  The ROLLUP's grand total comes from a Motion with nothing
-- computed on it, read as an input of the union of the other levels.
SET optimizer = on;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) WITH c AS (SELECT a.k, b.w, a.v FROM df_pt a JOIN df_pt2 b ON a.id = b.id * 700)
SELECT x.k, count(*), sum(x.v), sum(y.w) FROM c x JOIN c y ON x.k = y.w GROUP BY x.k;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Sequence
         ->  Shared Scan (share slice:id 1:0)
               ->  Hash Join
                     Hash Cond: (a.id = (b.id * 700))
                     ->  Seq Scan on df_pt a
                     ->  Hash
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: (b.id * 700)
                                 ->  Seq Scan on df_pt2 b
         ->  HashAggregate
               Group Key: share0_ref3.k
               ->  Hash Join
                     Hash Cond: (share0_ref3.k = share0_ref2.w)
                     ->  Redistribute Motion 3:3  (slice3; segments: 3)
                           Hash Key: share0_ref3.k
                           ->  Result
                                 ->  Shared Scan (share slice:id 3:0)
                     ->  Hash
                           ->  Redistribute Motion 3:3  (slice4; segments: 3)
                                 Hash Key: share0_ref2.w
                                 ->  Result
                                       ->  Shared Scan (share slice:id 4:0)
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible; below its Shared Scan producers: Hash Join
 DataFusion: slice 2 eligible
 DataFusion: slice 3 eligible, sends Arrow batches
 DataFusion: slice 4 eligible, sends Arrow batches
(29 rows)

EXPLAIN (COSTS OFF) WITH c AS (SELECT a.t, count(*) AS n, sum(a.v) AS s FROM df_pt a JOIN df_pt2 b ON a.id = b.id * 700 GROUP BY a.t)
SELECT x.t, x.n, y.s FROM c x JOIN c y ON x.t = y.t;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Sequence
         ->  Shared Scan (share slice:id 1:0)
               ->  HashAggregate
                     Group Key: a.t
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: a.t
                           ->  Hash Join
                                 Hash Cond: (a.id = (b.id * 700))
                                 ->  Seq Scan on df_pt a
                                 ->  Hash
                                       ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                             Hash Key: (b.id * 700)
                                             ->  Seq Scan on df_pt2 b
         ->  Hash Join
               Hash Cond: (share0_ref3.t = share0_ref2.t)
               ->  Shared Scan (share slice:id 1:0)
               ->  Hash
                     ->  Shared Scan (share slice:id 1:0)
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible; below its Shared Scan producers: Aggregate
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible
(24 rows)

EXPLAIN (COSTS OFF) WITH c AS (SELECT a.k, b.w, a.v FROM df_pt a JOIN df_pt2 b ON a.id = b.id * 700)
SELECT x.k, x.w, x.v, y.k, y.w, y.v FROM c x JOIN c y ON x.k = y.w;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Sequence
         ->  Shared Scan (share slice:id 1:0)
               ->  Hash Join
                     Hash Cond: (a.id = (b.id * 700))
                     ->  Seq Scan on df_pt a
                     ->  Hash
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: (b.id * 700)
                                 ->  Seq Scan on df_pt2 b
         ->  Hash Join
               Hash Cond: (share0_ref3.k = share0_ref2.w)
               ->  Redistribute Motion 3:3  (slice3; segments: 3)
                     Hash Key: share0_ref3.k
                     ->  Shared Scan (share slice:id 3:0)
               ->  Hash
                     ->  Redistribute Motion 3:3  (slice4; segments: 3)
                           Hash Key: share0_ref2.w
                           ->  Shared Scan (share slice:id 4:0)
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible; below its Shared Scan producers: Hash Join
 DataFusion: slice 2 eligible
 DataFusion: slice 3 eligible, sends Arrow batches
 DataFusion: slice 4 eligible, sends Arrow batches
(25 rows)

EXPLAIN (COSTS OFF) SELECT k, t, count(*), sum(v) FROM df_pt GROUP BY ROLLUP (k, t);
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Sequence
         ->  Shared Scan (share slice:id 1:0)
               ->  Seq Scan on df_pt
         ->  Append
               ->  Finalize HashAggregate
                     Group Key: share0_ref2.k, share0_ref2.t
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: share0_ref2.k, share0_ref2.t
                           ->  Streaming Partial HashAggregate
                                 Group Key: share0_ref2.k, share0_ref2.t
                                 ->  Shared Scan (share slice:id 2:0)
               ->  Finalize HashAggregate
                     Group Key: share0_ref3.k
                     ->  Redistribute Motion 3:3  (slice3; segments: 3)
                           Hash Key: share0_ref3.k
                           ->  Streaming Partial HashAggregate
                                 Group Key: share0_ref3.k
                                 ->  Shared Scan (share slice:id 3:0)
               ->  Result
                     ->  Redistribute Motion 1:3  (slice4)
                           ->  Finalize Aggregate
                                 ->  Gather Motion 3:1  (slice5; segments: 3)
                                       ->  Partial Aggregate
                                             ->  Shared Scan (share slice:id 5:0)
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible, sends Arrow batches
 DataFusion: slice 4 eligible
 DataFusion: slice 5 eligible, sends Arrow batches
(32 rows)

-- the Sort over the Sequence only sorts the rows of the coordinator's
-- Limit, sent back to the segments: nothing to compute on them (TPC-DS Q1)
EXPLAIN (COSTS OFF) WITH c AS (SELECT id % 500 AS g, k, sum(v) AS s FROM df_pt GROUP BY id % 500, k)
SELECT x.g, x.s FROM c x, (SELECT k, avg(s) AS a FROM c GROUP BY k) y
WHERE x.k = y.k AND x.s > y.a ORDER BY x.g, x.s LIMIT 4;
                                                                                QUERY PLAN                                                                                 
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: share0_ref3.g, share0_ref3.s
   ->  Sort
         Sort Key: share0_ref3.g, share0_ref3.s
         ->  Sequence
               ->  Shared Scan (share slice:id 1:0)
                     ->  HashAggregate
                           Group Key: ((df_pt.id % 500)), df_pt.k
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: ((df_pt.id % 500)), df_pt.k
                                 ->  Seq Scan on df_pt
               ->  Redistribute Motion 1:3  (slice3)
                     ->  Limit
                           ->  Gather Motion 3:1  (slice4; segments: 3)
                                 Merge Key: share0_ref3.g, share0_ref3.s
                                 ->  Limit
                                       ->  Sort
                                             Sort Key: share0_ref3.g, share0_ref3.s
                                             ->  Hash Join
                                                   Hash Cond: (share0_ref3.k = share0_ref2.k)
                                                   Join Filter: (share0_ref3.s > (avg(share0_ref2.s)))
                                                   ->  Shared Scan (share slice:id 4:0)
                                                   ->  Hash
                                                         ->  Broadcast Motion 3:3  (slice5; segments: 3)
                                                               ->  Finalize HashAggregate
                                                                     Group Key: share0_ref2.k
                                                                     ->  Redistribute Motion 3:3  (slice6; segments: 3)
                                                                           Hash Key: share0_ref2.k
                                                                           ->  Streaming Partial HashAggregate
                                                                                 Group Key: share0_ref2.k
                                                                                 ->  Shared Scan (share slice:id 6:0)
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible below the top: Aggregate (above: sorts at most 4 rows of a Limit, received from a Redistribute Motion, with nothing else to compute on them)
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 4 eligible
 DataFusion: slice 5 eligible
 DataFusion: slice 6 eligible, sends Arrow batches
(39 rows)

-- a UNION ALL as the producer's input runs in DataFusion as a whole: the
-- readers do not read the order its inputs come in (TPC-DS Q11)
EXPLAIN (COSTS OFF) WITH c AS (SELECT 's' AS src, k, sum(v) AS s FROM df_pt GROUP BY k
  UNION ALL SELECT 'w', w, count(*) FROM df_pt2 GROUP BY w)
SELECT x.k, x.s, y.s FROM c x JOIN c y ON x.k = y.k AND x.src = 's' AND y.src = 'w' ORDER BY x.k LIMIT 3;
                                                                               QUERY PLAN                                                                               
------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: share0_ref3.k
   ->  Sort
         Sort Key: share0_ref3.k
         ->  Sequence
               ->  Shared Scan (share slice:id 1:0)
                     ->  Append
                           ->  Result
                                 Filter: ((('s'::text) = 's'::text) OR (('s'::text) = 'w'::text))
                                 ->  Finalize HashAggregate
                                       Group Key: df_pt.k
                                       ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                             Hash Key: df_pt.k
                                             ->  Streaming Partial HashAggregate
                                                   Group Key: df_pt.k
                                                   ->  Seq Scan on df_pt
                           ->  Result
                                 Filter: ((('w'::text) = 's'::text) OR (('w'::text) = 'w'::text))
                                 ->  GroupAggregate
                                       Group Key: df_pt2.w
                                       ->  Sort
                                             Sort Key: df_pt2.w
                                             ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                                   Hash Key: df_pt2.w
                                                   ->  Seq Scan on df_pt2
               ->  Redistribute Motion 1:3  (slice4)
                     ->  Limit
                           ->  Gather Motion 3:1  (slice5; segments: 3)
                                 Merge Key: share0_ref3.k
                                 ->  Limit
                                       ->  Sort
                                             Sort Key: share0_ref3.k
                                             ->  Hash Join
                                                   Hash Cond: (share0_ref3.k = share0_ref2.k)
                                                   ->  Result
                                                         Filter: (share0_ref3.src = 's'::text)
                                                         ->  Shared Scan (share slice:id 5:0)
                                                   ->  Hash
                                                         ->  Result
                                                               Filter: (share0_ref2.src = 'w'::text)
                                                               ->  Shared Scan (share slice:id 5:0)
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible below the top: Append (above: sorts at most 3 rows of a Limit, received from a Redistribute Motion, with nothing else to compute on them)
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible, sends Arrow batches
 DataFusion: slice 4 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 5 eligible
(48 rows)

