  2 |  2307
  3 |     8
  3 |  2307
  4 |     8
  4 |  2307
  5 |  2307
  6 |  2307
  7 |  2307
  8 |  2307
  9 |  2307
 10 |  2306
 11 |  2306
 12 |  2306
(18 rows)

SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
SELECT a.k, count(*) FROM (SELECT k, count(*) AS c FROM df_pt GROUP BY k) a
JOIN df_pt2 b ON a.c > b.w * 500 GROUP BY a.k ORDER BY 1;
 k  | count 
----+-------
