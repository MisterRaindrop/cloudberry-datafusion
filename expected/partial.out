RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_sort;
SET optimizer = on;
SELECT k, count(*) FROM df_pt WHERE v > 100 GROUP BY k HAVING count(*) > 10 ORDER BY k LIMIT 5;
 k | count 
---+-------
 0 |  2306
 1 |  2306
 2 |  2307
 3 |  2307
 4 |  2307
(5 rows)

SET optimizer = off;
-- GPORCA's Shared Scan (a CTE read twice, a ROLLUP): below the Sequence,
-- the producer's input runs in DataFusion, which the producer reads once
-- into the store its readers share, in other slices (the first) or its
-- own (the second).  The readers stay on PostgreSQL.
SET optimizer = on;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) WITH c AS (SELECT a.k, b.w, a.v FROM df_pt a JOIN df_pt2 b ON a.id = b.id * 700)
SELECT x.k, count(*), sum(x.v), sum(y.w) FROM c x JOIN c y ON x.k = y.w GROUP BY x.k;
                                                  QUERY PLAN                                                  
--------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Sequence
         ->  Shared Scan (share slice:id 1:0)
               ->  Hash Join
                     Hash Cond: (a.id = (b.id * 700))
                     ->  Seq Scan on df_pt a
                     ->  Hash
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: (b.id * 700)
                                 ->  Seq Scan on df_pt2 b
         ->  HashAggregate
               Group Key: share0_ref3.k
               ->  Hash Join
                     Hash Cond: (share0_ref3.k = share0_ref2.w)
                     ->  Redistribute Motion 3:3  (slice3; segments: 3)
                           Hash Key: share0_ref3.k
                           ->  Result
                                 ->  Shared Scan (share slice:id 3:0)
                     ->  Hash
                           ->  Redistribute Motion 3:3  (slice4; segments: 3)
                                 Hash Key: share0_ref2.w
                                 ->  Result
                                       ->  Shared Scan (share slice:id 4:0)
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible below the top: Hash Join, Aggregate (above: plan node type 25 is not supported)
 DataFusion: slice 2 eligible
 DataFusion: slice 3 not eligible: Shared Scan is not supported
 DataFusion: slice 4 not eligible: Shared Scan is not supported
(29 rows)

EXPLAIN (COSTS OFF) WITH c AS (SELECT a.t, count(*) AS n, sum(a.v) AS s FROM df_pt a JOIN df_pt2 b ON a.id = b.id * 700 GROUP BY a.t)
SELECT x.t, x.n, y.s FROM c x JOIN c y ON x.t = y.t;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Sequence
         ->  Shared Scan (share slice:id 1:0)
               ->  HashAggregate
                     Group Key: a.t
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: a.t
                           ->  Hash Join
                                 Hash Cond: (a.id = (b.id * 700))
                                 ->  Seq Scan on df_pt a
                                 ->  Hash
                                       ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                             Hash Key: (b.id * 700)
                                             ->  Seq Scan on df_pt2 b
         ->  Hash Join
               Hash Cond: (share0_ref3.t = share0_ref2.t)
               ->  Shared Scan (share slice:id 1:0)
               ->  Hash
                     ->  Shared Scan (share slice:id 1:0)
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible below the top: Aggregate (above: plan node type 25 is not supported)
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible
(24 rows)

SET datafusion.mode = off;
WITH c AS (SELECT a.k, b.w, a.v FROM df_pt a JOIN df_pt2 b ON a.id = b.id * 700)
SELECT x.k, count(*), sum(x.v), sum(y.w) FROM c x JOIN c y ON x.k = y.w GROUP BY x.k ORDER BY 1;
 k | count |   sum   | sum 
---+-------+---------+-----
