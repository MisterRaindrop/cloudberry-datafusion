WITH c AS (SELECT a.k, b.w, a.v FROM df_pt a JOIN df_pt2 b ON a.id = b.id * 700)
SELECT x.k, x.w, x.v, y.k, y.w, y.v FROM c x JOIN c y ON x.k = y.w ORDER BY 1, 2, 3, 4, 5, 6;
