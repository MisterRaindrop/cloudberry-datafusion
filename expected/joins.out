-- GPORCA's Result (R1): a projection and filter over its child's rows,
-- here a HAVING and a test of an outer join's NULLs.
CREATE TABLE df_rs (k int, g int) DISTRIBUTED BY (k);
INSERT INTO df_rs SELECT i, i % 37 FROM generate_series(1, 10000) i;
ANALYZE df_rs;
SET optimizer = on;
SET datafusion.motion_batches = on;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT g, count(*) FROM df_rs GROUP BY g HAVING count(*) > 270 ORDER BY 1;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g
   ->  Sort
         Sort Key: g
         ->  Result
               Filter: ((count(*)) > 270)
               ->  Finalize HashAggregate
                     Group Key: g
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: g
                           ->  Streaming Partial HashAggregate
                                 Group Key: g
                                 ->  Seq Scan on df_rs
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(17 rows)

SET datafusion.mode = off;
