--
-- Table access methods (M6): heap, AO row, AO column and PAX tables are read
-- through the table AM interface on the main thread; column stores read only
-- the columns the scan uses.  Each table has deleted rows, so the AMs'
-- visibility information is exercised.  Each query runs with
-- datafusion.mode off, then on; the results must match.
--
CREATE EXTENSION datafusion_executor;
ALTER DATABASE contrib_regression SET session_preload_libraries = 'datafusion_executor';
\c
SET optimizer = off;
SET datafusion.worker_threads = 2;
CREATE TABLE df_m6_heap (a int4, b int8, c float8, e int2) USING heap DISTRIBUTED BY (a);
CREATE TABLE df_m6_ao (a int4, b int8, c float8, e int2) USING ao_row DISTRIBUTED BY (a);
CREATE TABLE df_m6_aocs (a int4, b int8, c float8, e int2) USING ao_column DISTRIBUTED BY (a);
CREATE TABLE df_m6_pax (a int4, b int8, c float8, e int2) USING pax DISTRIBUTED BY (a);
INSERT INTO df_m6_heap SELECT i, i * 10, i / 4.0, (i % 100)::int2 FROM generate_series(1, 100000) i;
INSERT INTO df_m6_heap VALUES (NULL, NULL, NULL, NULL);
INSERT INTO df_m6_ao SELECT * FROM df_m6_heap;
INSERT INTO df_m6_aocs SELECT * FROM df_m6_heap;
INSERT INTO df_m6_pax SELECT * FROM df_m6_heap;
DELETE FROM df_m6_heap WHERE a % 1000 = 7;
DELETE FROM df_m6_ao WHERE a % 1000 = 7;
DELETE FROM df_m6_aocs WHERE a % 1000 = 7;
DELETE FROM df_m6_pax WHERE a % 1000 = 7;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT count(*), sum(e) FROM df_m6_ao WHERE a > 10;
                   QUERY PLAN                   
------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on df_m6_ao
                     Filter: (a > 10)
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible
(8 rows)

EXPLAIN (COSTS OFF) SELECT count(*), sum(e) FROM df_m6_aocs WHERE a > 10;
                   QUERY PLAN                   
------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on df_m6_aocs
                     Filter: (a > 10)
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible
(8 rows)

EXPLAIN (COSTS OFF) SELECT count(*), sum(e) FROM df_m6_pax WHERE a > 10;
                   QUERY PLAN                   
------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on df_m6_pax
                     Filter: (a > 10)
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible
(8 rows)

SET datafusion.mode = off;
SELECT count(*), count(a), sum(a), sum(e), min(c), max(b) FROM df_m6_ao WHERE e < 50;
 count | count |    sum     |   sum   | min  |   max   
-------+-------+------------+---------+------+---------
 49900 | 49900 | 2493874300 | 1224300 | 0.25 | 1000000
(1 row)

SELECT count(*), count(a), sum(a), sum(e), min(c), max(b) FROM df_m6_aocs WHERE e < 50;
 count | count |    sum     |   sum   | min  |   max   
-------+-------+------------+---------+------+---------
 49900 | 49900 | 2493874300 | 1224300 | 0.25 | 1000000
(1 row)

SELECT count(*), count(a), sum(a), sum(e), min(c), max(b) FROM df_m6_pax WHERE e < 50;
 count | count |    sum     |   sum   | min  |   max   
-------+-------+------------+---------+------+---------
 49900 | 49900 | 2493874300 | 1224300 | 0.25 | 1000000
(1 row)

SET datafusion.mode = on;
SELECT count(*), count(a), sum(a), sum(e), min(c), max(b) FROM df_m6_ao WHERE e < 50;
 count | count |    sum     |   sum   | min  |   max   
-------+-------+------------+---------+------+---------
 49900 | 49900 | 2493874300 | 1224300 | 0.25 | 1000000
(1 row)

SELECT count(*), count(a), sum(a), sum(e), min(c), max(b) FROM df_m6_aocs WHERE e < 50;
 count | count |    sum     |   sum   | min  |   max   
-------+-------+------------+---------+------+---------
 49900 | 49900 | 2493874300 | 1224300 | 0.25 | 1000000
(1 row)

SELECT count(*), count(a), sum(a), sum(e), min(c), max(b) FROM df_m6_pax WHERE e < 50;
 count | count |    sum     |   sum   | min  |   max   
-------+-------+------------+---------+------+---------
 49900 | 49900 | 2493874300 | 1224300 | 0.25 | 1000000
(1 row)

SET datafusion.mode = off;
SELECT e, count(*), sum(a) FROM df_m6_pax WHERE e >= 97 OR e IS NULL GROUP BY e;
 e  | count |   sum    
----+-------+----------
    |     1 |         
 97 |  1000 | 50047000
 99 |  1000 | 50049000
 98 |  1000 | 50048000
(4 rows)

SELECT a, b, c FROM df_m6_aocs WHERE a % 25000 = 0 OR a % 1000 = 7;
   a    |    b    |   c   
--------+---------+-------
 100000 | 1000000 | 25000
  25000 |  250000 |  6250
  50000 |  500000 | 12500
  75000 |  750000 | 18750
(4 rows)

SET datafusion.mode = on;
SELECT e, count(*), sum(a) FROM df_m6_pax WHERE e >= 97 OR e IS NULL GROUP BY e;
 e  | count |   sum    
----+-------+----------
 98 |  1000 | 50048000
    |     1 |         
 97 |  1000 | 50047000
 99 |  1000 | 50049000
(4 rows)

SELECT a, b, c FROM df_m6_aocs WHERE a % 25000 = 0 OR a % 1000 = 7;
   a    |    b    |   c   
--------+---------+-------
  25000 |  250000 |  6250
  50000 |  500000 | 12500
  75000 |  750000 | 18750
 100000 | 1000000 | 25000
(4 rows)

-- The PAX scan below the partial aggregate runs in DataFusion's slice.
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT count(*), sum(a) FROM df_m6_pax WHERE e < 50;
                                      QUERY PLAN                                       
---------------------------------------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Gather Motion 3:1  (slice1; segments: 3) (actual rows=3 loops=1)
         ->  Partial Aggregate (actual rows=1 loops=1)
               ->  Seq Scan on df_m6_pax (never executed)
                     Filter: (e < 50)
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible
 DataFusion: 2 partitions, memory limit 32768 kB, peak 129 kB, spilled 0 kB in 0 files
(9 rows)

DROP TABLE df_m6_heap, df_m6_ao, df_m6_aocs, df_m6_pax;
ALTER DATABASE contrib_regression RESET session_preload_libraries;
DROP EXTENSION datafusion_executor;
