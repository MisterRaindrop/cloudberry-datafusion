SET datafusion.mode = off;
-- A key of 76 digits: the digits are placed without overflowing.
CREATE TABLE df_nc4 (id int, x numeric(38, 1)) DISTRIBUTED BY (id);
INSERT INTO df_nc4 SELECT i, 9999999999999999999999999999999999999.9 - i % 50
FROM generate_series(1, 200) i;
ANALYZE df_nc4;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT x * x, count(*) FROM df_nc4 GROUP BY x * x;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  HashAggregate
         Group Key: ((x * x))
         ->  Redistribute Motion 3:3  (slice2; segments: 3)
               Hash Key: ((x * x))
               ->  Seq Scan on df_nc4
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
