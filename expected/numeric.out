SET optimizer = off;
-- division by zero, as PostgreSQL raises it; a guard before it in an AND
-- keeps the rows it fails out
SELECT k, a / 0 FROM df_dn WHERE k = 5;
ERROR:  division by zero  (seg2 slice1 172.17.0.3:40002 pid=43496)
SELECT sum(a / b) FROM df_dn;
ERROR:  division by zero  (seg0 slice1 172.17.0.3:40000 pid=43495)
-- AV2: an avg returning numeric that DataFusion divides (pg_avg) holds
-- PostgreSQL's quotient at a fixed scale; numeric_avg's display scale,
-- picked from the sum and the count, goes beside it, so it sorts in
-- DataFusion and leaves it above its Agg, as DN1's values do.  Through
-- batches it passes as a value only.
SET datafusion.motion_batches = on;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT i, avg(a) FROM df_dn GROUP BY i ORDER BY avg(a) DESC NULLS LAST, i LIMIT 7;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Limit
   ->  Gather Motion 3:1  (slice1; segments: 3)
         Merge Key: (avg(a)), i
         ->  Limit
               ->  Sort
                     Sort Key: (avg(a)) DESC NULLS LAST, i
                     ->  Finalize HashAggregate
                           Group Key: i
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: i
                                 ->  Streaming Partial HashAggregate
                                       Group Key: i
                                       ->  Seq Scan on df_dn
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(17 rows)

EXPLAIN (COSTS OFF) SELECT x.g, x.m, y.n FROM (SELECT i g, avg(a) m FROM df_dn GROUP BY i) x JOIN (SELECT i, count(*) n FROM df_dn GROUP BY i) y ON y.i = x.g ORDER BY 1;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: df_dn_1.i
   ->  Sort
         Sort Key: df_dn_1.i
         ->  Hash Join
               Hash Cond: (df_dn.i = df_dn_1.i)
               ->  Finalize HashAggregate
                     Group Key: df_dn.i
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: df_dn.i
                           ->  Streaming Partial HashAggregate
                                 Group Key: df_dn.i
                                 ->  Seq Scan on df_dn
               ->  Hash
                     ->  Finalize HashAggregate
                           Group Key: df_dn_1.i
                           ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                 Hash Key: df_dn_1.i
                                 ->  Streaming Partial HashAggregate
                                       Group Key: df_dn_1.i
                                       ->  Seq Scan on df_dn df_dn_1
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible, sends Arrow batches
(26 rows)

EXPLAIN (COSTS OFF) SELECT g, m, m * 3 FROM (SELECT i g, avg(a) m FROM df_dn GROUP BY i OFFSET 0) x ORDER BY m DESC, g;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: x.m, x.g
   ->  Sort
         Sort Key: x.m DESC, x.g
         ->  Subquery Scan on x
               ->  Finalize HashAggregate
                     Group Key: df_dn.i
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: df_dn.i
                           ->  Streaming Partial HashAggregate
                                 Group Key: df_dn.i
                                 ->  Seq Scan on df_dn
