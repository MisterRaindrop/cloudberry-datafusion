                 ->  Partial Aggregate
                       ->  Seq Scan on df_nc df_nc_1
                             Filter: (id > 0)
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on df_nc
                     Filter: (a > $0)
