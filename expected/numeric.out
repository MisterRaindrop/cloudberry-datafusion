-- Redistributed by numeric keys as batches: hash_numeric of the NBASE
-- digits, placed by the column's scale (df_core::cdbhash).  df_nc3 is
-- distributed by PostgreSQL's hash, which the rows redistributed to join
-- it must meet.
CREATE TABLE df_nc3 AS SELECT b AS k, id FROM df_nc, generate_series(1, 3)
DISTRIBUTED BY (k);
ANALYZE df_nc3;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT b, count(*) FROM df_nc GROUP BY b;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  HashAggregate
         Group Key: b
         ->  Redistribute Motion 3:3  (slice2; segments: 3)
               Hash Key: b
               ->  Seq Scan on df_nc
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(10 rows)

EXPLAIN (COSTS OFF) SELECT count(*), sum(x.id) FROM df_nc x JOIN df_nc3 y ON x.b = y.k;
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (y.k = x.b)
                     ->  Seq Scan on df_nc3 y
                     ->  Hash
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: x.b
                                 ->  Seq Scan on df_nc x
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible, sends Arrow batches
 DataFusion: slice 2 eligible, sends Arrow batches
(14 rows)

SET datafusion.mode = off;
SELECT count(*), sum(x.id) FROM df_nc x JOIN df_nc3 y ON x.b = y.k;
 count  |    sum     
--------+------------
 150018 | 3750074925
(1 row)

SET datafusion.mode = on;
SELECT count(*), sum(x.id) FROM df_nc x JOIN df_nc3 y ON x.b = y.k;
 count  |    sum     
--------+------------
 150018 | 3750074925
(1 row)

SET datafusion.mode = off;
