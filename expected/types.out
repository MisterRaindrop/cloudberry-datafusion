-- ctid and gp_segment_id of a scan (TID1: GPORCA dedupes a semi join's
-- side by them, TPC-H Q21), ctid carried as block << 16 | offset; a tid
-- constant stays on PostgreSQL.
CREATE TABLE df_ct (a int, b text) DISTRIBUTED BY (a);
INSERT INTO df_ct SELECT i, 'x' || i FROM generate_series(1, 3000) i;
DELETE FROM df_ct WHERE a % 7 = 0;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT count(*), count(DISTINCT ctid), min(ctid) FROM df_ct;
                            QUERY PLAN                            
------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Redistribute Motion 3:3  (slice2; segments: 3)
                     Hash Key: ctid
                     ->  Seq Scan on df_ct
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible, sends Arrow batches
 DataFusion: slice 2 eligible, sends Arrow batches
(10 rows)

EXPLAIN (COSTS OFF) SELECT a FROM df_ct WHERE ctid > '(0,5)';
NOTICE:  SELECT uses system-defined column "df_ct.ctid" without the necessary companion column "df_ct.gp_segment_id"
HINT:  To uniquely identify a row within a distributed table, use the "gp_segment_id" column together with the "ctid" column.
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on df_ct
         Filter: (ctid > '(0,5)'::tid)
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 not eligible: constant of type tid
(6 rows)

