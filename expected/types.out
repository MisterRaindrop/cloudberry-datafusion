DROP TABLE df_ty3;
-- extract(year | quarter | month | day from date) as numeric of scale 0
-- (DT2).  The year of an infinite date is ±Infinity, which DataFusion
-- groups, sorts, compares at scale 0 and returns, but arithmetic, sums,
-- casts and rescaling comparisons on it stay on PostgreSQL.
CREATE TABLE df_ty4 (id int4, d date) DISTRIBUTED BY (id);
INSERT INTO df_ty4 SELECT i, date '1992-01-01' + (i * 7919) % 2600 FROM generate_series(1, 3000) i;
INSERT INTO df_ty4 VALUES (-1, '-infinity'), (-2, 'infinity'), (-3, '4714-11-24 BC'),
  (-4, '0001-12-31 BC'), (-5, '0001-01-01'), (-6, '5874897-12-31'), (-7, '2000-02-29'),
  (-8, NULL), (-9, 'infinity');
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT extract(year from d), count(*) FROM df_ty4 GROUP BY 1;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Finalize HashAggregate
         Group Key: (EXTRACT(year FROM d))
         ->  Redistribute Motion 3:3  (slice2; segments: 3)
               Hash Key: (EXTRACT(year FROM d))
               ->  Streaming Partial HashAggregate
                     Group Key: EXTRACT(year FROM d)
                     ->  Seq Scan on df_ty4
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible
(12 rows)

EXPLAIN (COSTS OFF) SELECT sum(extract(year from d)) FROM df_ty4;
                                    QUERY PLAN                                     
-----------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on df_ty4
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: combining aggregate sum without batch Motions
 DataFusion: slice 1 not eligible: aggregate sum of a numeric that may be infinite
(7 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM df_ty4 WHERE extract(year from d) > 1995.5;
                                      QUERY PLAN                                       
---------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on df_ty4
                     Filter: (EXTRACT(year FROM d) > 1995.5)
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 not eligible: operator > rescaling a numeric that may be infinite
(8 rows)

