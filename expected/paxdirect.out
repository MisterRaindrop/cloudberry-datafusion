(3 rows)

SELECT datafusion_debug_pax_direct_scans() AS direct_scans;
 direct_scans 
--------------
            7
(1 row)

-- Rows inserted and deleted earlier in the same transaction are seen as
-- the snapshot sees them.
BEGIN;
INSERT INTO df_pd SELECT i, i, i, true, 1 FROM generate_series(400001, 400010) i;
DELETE FROM df_pd WHERE a BETWEEN 1 AND 100;
SELECT count(*), sum(a) FROM df_pd;
 count  |     sum     
--------+-------------
 299613 | 44959592913
(1 row)

SET datafusion.mode = off;
SELECT count(*), sum(a) FROM df_pd;
 count  |     sum     
--------+-------------
 299613 | 44959592913
(1 row)

ROLLBACK;
SET datafusion.mode = on;
SELECT count(*), sum(a) FROM df_pd;
 count  |     sum     
--------+-------------
 299702 | 44955597901
(1 row)

-- Min/max skipping: micro-partitions and groups whose statistics rule out
-- the scan's qual are not read (4 micro-partitions of 8 groups or fewer).
-- Only column a has statistics.
SET pax.max_tuples_per_file = 131072;
SET pax.max_tuples_per_group = 16384;
CREATE TABLE df_pd_skip (a int4, b int8, e int2) USING pax WITH (minmax_columns = 'a');
INSERT INTO df_pd_skip SELECT i, i * 10, (i % 100)::int2 FROM generate_series(1, 500000) i;
RESET pax.max_tuples_per_file;
RESET pax.max_tuples_per_group;
SET datafusion.mode = off;
SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a BETWEEN 200000 AND 210000;
 count |    sum     |   max   
-------+------------+---------
 10001 | 2050205000 | 2100000
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a < 5000 OR a > 490000;
 count |    sum     |   max   
-------+------------+---------
 14999 | 4962502500 | 5000000
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a > 600000;
 count | sum | max 
-------+-----+-----
     0 |     |    
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE e = 7;
 count |    sum     |   max   
-------+------------+---------
  5000 | 1249785000 | 4999070
(1 row)

SET datafusion.mode = on;
SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a BETWEEN 200000 AND 210000;
 count |    sum     |   max   
-------+------------+---------
 10001 | 2050205000 | 2100000
(1 row)

SELECT files, files_skipped, groups, groups_skipped, decode_peak_kb > 0 AS decoded
FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped | decoded 
-------+---------------+--------+----------------+---------
     4 |             3 |      8 |              7 | t
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a < 5000 OR a > 490000;
 count |    sum     |   max   
-------+------------+---------
 14999 | 4962502500 | 5000000
(1 row)

SELECT files, files_skipped, groups, groups_skipped FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped 
-------+---------------+--------+----------------
     4 |             2 |     15 |             12
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a > 600000;
 count | sum | max 
-------+-----+-----
     0 |     |    
(1 row)

SELECT files, files_skipped, groups, groups_skipped, decode_peak_kb FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped | decode_peak_kb 
-------+---------------+--------+----------------+----------------
     4 |             4 |      0 |              0 |              0
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE e = 7;
 count |    sum     |   max   
-------+------------+---------
  5000 | 1249785000 | 4999070
(1 row)

SELECT files, files_skipped, groups, groups_skipped FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped 
-------+---------------+--------+----------------
     4 |             0 |     31 |              0
(1 row)

-- PAX's switch for its own skipping applies too.
SET pax.enable_sparse_filter = off;
SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a BETWEEN 200000 AND 210000;
 count |    sum     |   max   
-------+------------+---------
 10001 | 2050205000 | 2100000
(1 row)

SELECT files, files_skipped, groups, groups_skipped FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped 
-------+---------------+--------+----------------
     4 |             0 |      0 |              0
(1 row)

RESET pax.enable_sparse_filter;
-- Statistics on a date column skip as well.
SET pax.max_tuples_per_group = 16384;
CREATE TABLE df_pd_date (d date, ts timestamp) USING pax WITH (minmax_columns = 'd');
INSERT INTO df_pd_date SELECT date '1990-01-01' + i / 100, timestamp '1990-01-01' + i * interval '1 minute'
FROM generate_series(1, 100000) i;
INSERT INTO df_pd_date VALUES ('infinity', '-infinity'), (NULL, NULL);
RESET pax.max_tuples_per_group;
SET datafusion.mode = off;
SELECT count(*), min(ts), max(ts) FROM df_pd_date WHERE d >= '1991-03-01' AND d < '1991-04-01';
 count |           min            |           max            
-------+--------------------------+--------------------------
  3100 | Tue Jan 30 10:40:00 1990 | Thu Feb 01 14:19:00 1990
(1 row)

SELECT d, ts FROM df_pd_date WHERE d > '2040-01-01' OR d IS NULL ORDER BY d, ts;
    d     |    ts     
----------+-----------
 infinity | -infinity
          | 
(2 rows)

SET datafusion.mode = on;
SELECT count(*), min(ts), max(ts) FROM df_pd_date WHERE d >= '1991-03-01' AND d < '1991-04-01';
 count |           min            |           max            
-------+--------------------------+--------------------------
  3100 | Tue Jan 30 10:40:00 1990 | Thu Feb 01 14:19:00 1990
(1 row)

SELECT files, files_skipped, groups, groups_skipped FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped 
-------+---------------+--------+----------------
     2 |             1 |      7 |              6
(1 row)

SELECT d, ts FROM df_pd_date WHERE d > '2040-01-01' OR d IS NULL ORDER BY d, ts;
    d     |    ts     
----------+-----------
 infinity | -infinity
          | 
(2 rows)

-- The memory PAX's reader held is given back once the scan is over.
SELECT count(*) FROM df_pd_skip;
 count  
--------
 500000
(1 row)

SELECT heap_bytes < 4 * 1024 * 1024 AS heap_returned FROM datafusion_debug_vmem();
 heap_returned 
---------------
 t
(1 row)

DROP TABLE df_pd, df_pd_vec, df_pd_skip, df_pd_date;
ALTER DATABASE contrib_regression SET session_preload_libraries = 'datafusion_executor';
\c
SET optimizer = off;
SET datafusion.worker_threads = 2;
CREATE TABLE df_pd_dist (a int4, b int8, c float8, e int2) USING pax DISTRIBUTED BY (a);
INSERT INTO df_pd_dist SELECT i, i * 10, i / 4.0, (i % 100)::int2 FROM generate_series(1, 200000) i;
INSERT INTO df_pd_dist VALUES (NULL, NULL, NULL, NULL);
DELETE FROM df_pd_dist WHERE a % 1000 = 7;
SET datafusion.mode = off;
SELECT count(*), count(a), sum(a), max(c), sum(e) FROM df_pd_dist WHERE e < 50;
 count | count |    sum     |  max  |   sum   
-------+-------+------------+-------+---------
 99800 | 99800 | 9977748600 | 50000 | 2448600
(1 row)

SELECT e, count(*), sum(a) FROM df_pd_dist WHERE e >= 97 OR e IS NULL GROUP BY e ORDER BY e;
 e  | count |    sum    
----+-------+-----------
 97 |  2000 | 200094000
 98 |  2000 | 200096000
 99 |  2000 | 200098000
    |     1 |          
(4 rows)

SET datafusion.mode = on;
SET datafusion.pax_direct_read = on;
SELECT count(*), count(a), sum(a), max(c), sum(e) FROM df_pd_dist WHERE e < 50;
 count | count |    sum     |  max  |   sum   
-------+-------+------------+-------+---------
 99800 | 99800 | 9977748600 | 50000 | 2448600
(1 row)

SELECT e, count(*), sum(a) FROM df_pd_dist WHERE e >= 97 OR e IS NULL GROUP BY e ORDER BY e;
 e  | count |    sum    
----+-------+-----------
 97 |  2000 | 200094000
 98 |  2000 | 200096000
 99 |  2000 | 200098000
    |     1 |          
(4 rows)

-- Strings (C1): text, varchar and char(n) as offsets and bytes, with NULLs,
-- empty strings, multibyte characters and char(n)'s padding; values PAX
-- compressed (over pax.min_size_of_compress_toast) or put in its toast file
-- (over pax.min_size_of_external_toast); the vectorized storage format,
-- which keeps char(n) without padding and strings without headers.  Groups
-- of 1000 rows give each segment's one micro-partition several groups,
-- which DataFusion's partitions read in parallel (C1b).
SET pax.max_tuples_per_group = 1000;
CREATE TABLE df_pd_str (id int, t text, v varchar(12), b char(5)) USING pax DISTRIBUTED BY (id);
INSERT INTO df_pd_str SELECT k,
  CASE WHEN k % 11 = 0 THEN NULL WHEN k % 7 = 0 THEN '' ELSE 'é' || k END,
  CASE WHEN k % 13 = 0 THEN NULL ELSE substr('中文字符串abcdefgh', 1 + k % 5, k % 12) END,
  CASE WHEN k % 17 = 0 THEN NULL WHEN k % 5 = 0 THEN '' ELSE chr(97 + k % 26) || (k % 100) END
FROM generate_series(1, 20000) k;
INSERT INTO df_pd_str VALUES (-1, repeat('ab', 300000), 'big', 'z'),
  (-2, repeat('xyz', 3600000), 'bigger', 'z');
DELETE FROM df_pd_str WHERE id % 1000 = 3;
RESET pax.max_tuples_per_group;
CREATE TABLE df_pd_vec (id int, t text, b char(4)) USING pax
  WITH (storage_format = porc_vec) DISTRIBUTED BY (id);
INSERT INTO df_pd_vec SELECT k, CASE WHEN k % 9 = 0 THEN NULL ELSE 'v' || k END,
  CASE WHEN k % 6 = 0 THEN NULL ELSE (k % 50)::text END FROM generate_series(1, 5000) k;
SET datafusion.mode = off;
SET datafusion.pax_direct_read = off;
SELECT count(*), count(t), count(v), count(b), sum(length(t)), sum(length(v)), sum(octet_length(b)) FROM df_pd_str;
 count | count | count | count |   sum    |  sum   |  sum  
-------+-------+-------+-------+----------+--------+-------
 19982 | 18166 | 18446 | 18808 | 11484765 | 100201 | 94040
(1 row)

