--
-- The experimental direct PAX reader (datafusion.pax_direct_read): PAX
-- micro-partitions decoded column by column on DataFusion's threads,
-- through datafusion_pax.so.  The coordinator-local part runs in utility
-- mode (data/paxdirect_utility.sql); a distributed table exercises the
-- segments.  Each query runs with the reader off, then on; results match.
--
CREATE EXTENSION datafusion_executor;
\! PGOPTIONS='-c gp_role=utility' psql -X -a -q -d contrib_regression -f data/paxdirect_utility.sql 2>&1
-- Licensed to the Apache Software Foundation (ASF) under one
-- or more contributor license agreements.  See the NOTICE file
-- distributed with this work for additional information
-- regarding copyright ownership.  The ASF licenses this file
-- to you under the Apache License, Version 2.0 (the
-- "License"); you may not use this file except in compliance
-- with the License.  You may obtain a copy of the License at
--
--   http://www.apache.org/licenses/LICENSE-2.0
--
-- Unless required by applicable law or agreed to in writing,
-- software distributed under the License is distributed on an
-- "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
-- KIND, either express or implied.  See the License for the
-- specific language governing permissions and limitations
-- under the License.
--
-- Body of the paxdirect test, run in utility mode on the coordinator by
-- sql/paxdirect.sql, so that the scans and the counter of direct reads are
-- in the same backend.  Each query runs with datafusion.mode off, then on
-- with datafusion.pax_direct_read; the results must match, and the counter
-- shows that the PAX reader read the table directly.
--
LOAD 'datafusion_executor';
CREATE TABLE df_pd (a int4, b int8, c float8, d bool, e int2) USING pax;
CREATE TABLE df_pd_vec (a int4, b int8, c float8, d bool, e int2) USING pax
  WITH (storage_format = 'porc_vec');
INSERT INTO df_pd SELECT i, i * 10, i / 4.0, i % 2 = 0, (i % 100)::int2
FROM generate_series(1, 300000) i;
INSERT INTO df_pd VALUES (NULL, NULL, NULL, NULL, NULL), (300001, NULL, 1.5, NULL, 7);
INSERT INTO df_pd_vec SELECT * FROM df_pd;
DELETE FROM df_pd WHERE a % 1000 = 7;
DELETE FROM df_pd_vec WHERE a % 1000 = 7;
SET datafusion.mode = off;
SELECT count(*), count(a), count(b), sum(a), sum(e), min(c), max(b) FROM df_pd WHERE e < 50;
 count  | count  | count  |     sum     |   sum   | min  |   max   
--------+--------+--------+-------------+---------+------+---------
 149701 | 149701 | 149700 | 22451922901 | 3672907 | 0.25 | 3000000
(1 row)

SELECT d, count(*), min(e), max(c) FROM df_pd GROUP BY d;
 d | count  | min |   max    
---+--------+-----+----------
 f | 149700 |   1 | 74999.75
   |      2 |   7 |      1.5
 t | 150000 |   0 |    75000
(3 rows)

SELECT count(*) FROM df_pd;
 count  
--------
 299702
(1 row)

SELECT a, b, c, d, e FROM df_pd WHERE a % 100000 = 0 OR a % 1000 = 7 OR a IS NULL OR b IS NULL;
   a    |    b    |   c   | d | e 
--------+---------+-------+---+---
        |         |       |   |  
 300001 |         |   1.5 |   | 7
 100000 | 1000000 | 25000 | t | 0
 200000 | 2000000 | 50000 | t | 0
 300000 | 3000000 | 75000 | t | 0
(5 rows)

SELECT count(*), count(a), count(b), sum(a), sum(e), min(c), max(b) FROM df_pd_vec WHERE e < 50;
 count  | count  | count  |     sum     |   sum   | min  |   max   
--------+--------+--------+-------------+---------+------+---------
 149701 | 149701 | 149700 | 22451922901 | 3672907 | 0.25 | 3000000
(1 row)

SELECT a, b, c, d, e FROM df_pd_vec WHERE a % 100000 = 0 OR a IS NULL OR b IS NULL;
   a    |    b    |   c   | d | e 
--------+---------+-------+---+---
 100000 | 1000000 | 25000 | t | 0
 200000 | 2000000 | 50000 | t | 0
 300000 | 3000000 | 75000 | t | 0
        |         |       |   |  
 300001 |         |   1.5 |   | 7
(5 rows)

SELECT d, count(*), sum(e) FROM df_pd_vec GROUP BY d;
 d | count  |   sum   
---+--------+---------
   |      2 |       7
 f | 149700 | 7497900
 t | 150000 | 7350000
(3 rows)

SET datafusion.mode = on;
SET datafusion.pax_direct_read = on;
SELECT count(*), count(a), count(b), sum(a), sum(e), min(c), max(b) FROM df_pd WHERE e < 50;
 count  | count  | count  |     sum     |   sum   | min  |   max   
--------+--------+--------+-------------+---------+------+---------
 149701 | 149701 | 149700 | 22451922901 | 3672907 | 0.25 | 3000000
(1 row)

SELECT d, count(*), min(e), max(c) FROM df_pd GROUP BY d;
 d | count  | min |   max    
---+--------+-----+----------
   |      2 |   7 |      1.5
 f | 149700 |   1 | 74999.75
 t | 150000 |   0 |    75000
(3 rows)

SELECT count(*) FROM df_pd;
 count  
--------
 299702
(1 row)

SELECT a, b, c, d, e FROM df_pd WHERE a % 100000 = 0 OR a % 1000 = 7 OR a IS NULL OR b IS NULL;
   a    |    b    |   c   | d | e 
--------+---------+-------+---+---
        |         |       |   |  
 300001 |         |   1.5 |   | 7
 100000 | 1000000 | 25000 | t | 0
 200000 | 2000000 | 50000 | t | 0
 300000 | 3000000 | 75000 | t | 0
(5 rows)

SELECT count(*), count(a), count(b), sum(a), sum(e), min(c), max(b) FROM df_pd_vec WHERE e < 50;
 count  | count  | count  |     sum     |   sum   | min  |   max   
--------+--------+--------+-------------+---------+------+---------
 149701 | 149701 | 149700 | 22451922901 | 3672907 | 0.25 | 3000000
(1 row)

SELECT a, b, c, d, e FROM df_pd_vec WHERE a % 100000 = 0 OR a IS NULL OR b IS NULL;
   a    |    b    |   c   | d | e 
--------+---------+-------+---+---
 100000 | 1000000 | 25000 | t | 0
 200000 | 2000000 | 50000 | t | 0
 300000 | 3000000 | 75000 | t | 0
        |         |       |   |  
 300001 |         |   1.5 |   | 7
(5 rows)

SELECT d, count(*), sum(e) FROM df_pd_vec GROUP BY d;
 d | count  |   sum   
---+--------+---------
   |      2 |       7
 f | 149700 | 7497900
 t | 150000 | 7350000
(3 rows)

SELECT datafusion_debug_pax_direct_scans() AS direct_scans;
 direct_scans 
--------------
            7
(1 row)

-- Rows inserted and deleted earlier in the same transaction are seen as
-- the snapshot sees them.
BEGIN;
INSERT INTO df_pd SELECT i, i, i, true, 1 FROM generate_series(400001, 400010) i;
DELETE FROM df_pd WHERE a BETWEEN 1 AND 100;
SELECT count(*), sum(a) FROM df_pd;
 count  |     sum     
--------+-------------
 299613 | 44959592913
(1 row)

SET datafusion.mode = off;
SELECT count(*), sum(a) FROM df_pd;
 count  |     sum     
--------+-------------
 299613 | 44959592913
(1 row)

ROLLBACK;
SET datafusion.mode = on;
SELECT count(*), sum(a) FROM df_pd;
 count  |     sum     
--------+-------------
 299702 | 44955597901
(1 row)

-- Min/max skipping: micro-partitions and groups whose statistics rule out
-- the scan's qual are not read (4 micro-partitions of 8 groups or fewer).
-- Only column a has statistics.
SET pax.max_tuples_per_file = 131072;
SET pax.max_tuples_per_group = 16384;
CREATE TABLE df_pd_skip (a int4, b int8, e int2) USING pax WITH (minmax_columns = 'a');
INSERT INTO df_pd_skip SELECT i, i * 10, (i % 100)::int2 FROM generate_series(1, 500000) i;
RESET pax.max_tuples_per_file;
RESET pax.max_tuples_per_group;
SET datafusion.mode = off;
SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a BETWEEN 200000 AND 210000;
 count |    sum     |   max   
-------+------------+---------
 10001 | 2050205000 | 2100000
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a < 5000 OR a > 490000;
 count |    sum     |   max   
-------+------------+---------
 14999 | 4962502500 | 5000000
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a > 600000;
 count | sum | max 
-------+-----+-----
     0 |     |    
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE e = 7;
 count |    sum     |   max   
-------+------------+---------
  5000 | 1249785000 | 4999070
(1 row)

SET datafusion.mode = on;
SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a BETWEEN 200000 AND 210000;
 count |    sum     |   max   
-------+------------+---------
 10001 | 2050205000 | 2100000
(1 row)

SELECT files, files_skipped, groups, groups_skipped, decode_peak_kb > 0 AS decoded
FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped | decoded 
-------+---------------+--------+----------------+---------
     4 |             3 |      8 |              7 | t
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a < 5000 OR a > 490000;
 count |    sum     |   max   
-------+------------+---------
 14999 | 4962502500 | 5000000
(1 row)

SELECT files, files_skipped, groups, groups_skipped FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped 
-------+---------------+--------+----------------
     4 |             2 |     15 |             12
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a > 600000;
 count | sum | max 
-------+-----+-----
     0 |     |    
(1 row)

SELECT files, files_skipped, groups, groups_skipped, decode_peak_kb FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped | decode_peak_kb 
-------+---------------+--------+----------------+----------------
     4 |             4 |      0 |              0 |              0
(1 row)

SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE e = 7;
 count |    sum     |   max   
-------+------------+---------
  5000 | 1249785000 | 4999070
(1 row)

SELECT files, files_skipped, groups, groups_skipped FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped 
-------+---------------+--------+----------------
     4 |             0 |     31 |              0
(1 row)

-- PAX's switch for its own skipping applies too.
SET pax.enable_sparse_filter = off;
SELECT count(*), sum(a), max(b) FROM df_pd_skip WHERE a BETWEEN 200000 AND 210000;
 count |    sum     |   max   
-------+------------+---------
 10001 | 2050205000 | 2100000
(1 row)

SELECT files, files_skipped, groups, groups_skipped FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped 
-------+---------------+--------+----------------
     4 |             0 |      0 |              0
(1 row)

RESET pax.enable_sparse_filter;
-- Statistics on a date column skip as well.
SET pax.max_tuples_per_group = 16384;
CREATE TABLE df_pd_date (d date, ts timestamp) USING pax WITH (minmax_columns = 'd');
INSERT INTO df_pd_date SELECT date '1990-01-01' + i / 100, timestamp '1990-01-01' + i * interval '1 minute'
FROM generate_series(1, 100000) i;
INSERT INTO df_pd_date VALUES ('infinity', '-infinity'), (NULL, NULL);
RESET pax.max_tuples_per_group;
SET datafusion.mode = off;
SELECT count(*), min(ts), max(ts) FROM df_pd_date WHERE d >= '1991-03-01' AND d < '1991-04-01';
 count |           min            |           max            
-------+--------------------------+--------------------------
  3100 | Tue Jan 30 10:40:00 1990 | Thu Feb 01 14:19:00 1990
(1 row)

SELECT d, ts FROM df_pd_date WHERE d > '2040-01-01' OR d IS NULL;
    d     |    ts     
----------+-----------
 infinity | -infinity
          | 
(2 rows)

SET datafusion.mode = on;
SELECT count(*), min(ts), max(ts) FROM df_pd_date WHERE d >= '1991-03-01' AND d < '1991-04-01';
 count |           min            |           max            
-------+--------------------------+--------------------------
  3100 | Tue Jan 30 10:40:00 1990 | Thu Feb 01 14:19:00 1990
(1 row)

SELECT files, files_skipped, groups, groups_skipped FROM datafusion_debug_last_pax();
 files | files_skipped | groups | groups_skipped 
-------+---------------+--------+----------------
     2 |             1 |      7 |              6
(1 row)

SELECT d, ts FROM df_pd_date WHERE d > '2040-01-01' OR d IS NULL;
    d     |    ts     
----------+-----------
 infinity | -infinity
          | 
(2 rows)

-- The memory PAX's reader held is given back once the scan is over.
SELECT count(*) FROM df_pd_skip;
 count  
--------
 500000
(1 row)

SELECT heap_bytes < 4 * 1024 * 1024 AS heap_returned FROM datafusion_debug_vmem();
 heap_returned 
---------------
 t
(1 row)

DROP TABLE df_pd, df_pd_vec, df_pd_skip, df_pd_date;
ALTER DATABASE contrib_regression SET session_preload_libraries = 'datafusion_executor';
\c
SET optimizer = off;
SET datafusion.worker_threads = 2;
CREATE TABLE df_pd_dist (a int4, b int8, c float8, e int2) USING pax DISTRIBUTED BY (a);
INSERT INTO df_pd_dist SELECT i, i * 10, i / 4.0, (i % 100)::int2 FROM generate_series(1, 200000) i;
INSERT INTO df_pd_dist VALUES (NULL, NULL, NULL, NULL);
DELETE FROM df_pd_dist WHERE a % 1000 = 7;
SET datafusion.mode = off;
SELECT count(*), count(a), sum(a), max(c), sum(e) FROM df_pd_dist WHERE e < 50;
 count | count |    sum     |  max  |   sum   
-------+-------+------------+-------+---------
 99800 | 99800 | 9977748600 | 50000 | 2448600
(1 row)

SELECT e, count(*), sum(a) FROM df_pd_dist WHERE e >= 97 OR e IS NULL GROUP BY e;
 e  | count |    sum    
----+-------+-----------
    |     1 |          
 97 |  2000 | 200094000
 99 |  2000 | 200098000
 98 |  2000 | 200096000
(4 rows)

SET datafusion.mode = on;
SET datafusion.pax_direct_read = on;
SELECT count(*), count(a), sum(a), max(c), sum(e) FROM df_pd_dist WHERE e < 50;
 count | count |    sum     |  max  |   sum   
-------+-------+------------+-------+---------
 99800 | 99800 | 9977748600 | 50000 | 2448600
(1 row)

SELECT e, count(*), sum(a) FROM df_pd_dist WHERE e >= 97 OR e IS NULL GROUP BY e;
 e  | count |    sum    
----+-------+-----------
    |     1 |          
 97 |  2000 | 200094000
 99 |  2000 | 200098000
 98 |  2000 | 200096000
(4 rows)

DROP TABLE df_pd_dist;
ALTER DATABASE contrib_regression RESET session_preload_libraries;
DROP EXTENSION datafusion_executor;
