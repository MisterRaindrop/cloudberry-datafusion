    | 40769
(3 rows)

-- the division only runs where b <> 0, as in PostgreSQL
SELECT sum(CASE WHEN b = 0 THEN 0 ELSE 100 / b END), count(*) FROM df_ex;
   sum   | count 
---------+-------
 1742892 | 50000
(1 row)

SELECT count(*), sum(coalesce(a, -1)), sum(coalesce(a, b, 0)) FROM df_ex;
 count |  sum   |  sum   
-------+--------+--------
