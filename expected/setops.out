--
-- Set operations.  SO1: INTERSECT and EXCEPT (SetOp), as a grouping by
-- their columns counting each side's rows; not the ALL forms, nor columns
-- whose equal values may look different (numeric, floats, character
-- without a length).
-- UA1: UNION ALL (Append), as DataFusion's union of its
-- inputs, which keeps no order between them: an Append whose order a node
-- above reads stays on PostgreSQL; a Merge Append whose order nothing
-- reads runs as one, and a GroupAggregate whose order nothing reads runs
-- hashed whatever its input (TPC-DS Q33).  Numeric of different scales, or of
-- display scales of their own, carries each value's display scale beside
-- it.  Inputs that are Motions (GPORCA redistributes each branch below
-- the Append) are read from their streams.  Each query runs with
-- datafusion.mode off, then on; the two results must match.
--
CREATE EXTENSION datafusion_executor;
ALTER DATABASE contrib_regression SET session_preload_libraries = 'datafusion_executor';
\c
SET datafusion.worker_threads = 2;
SET datafusion.motion_batches = on;
CREATE TABLE df_u1 (k int, g int, a numeric(7,2), b int8, t text, c char(4)) DISTRIBUTED BY (k);
CREATE TABLE df_u2 (k int, g int, a numeric(12,4), b int4, t varchar(10), c char(4)) DISTRIBUTED BY (k);
INSERT INTO df_u1 SELECT i, i % 7, CASE WHEN i % 97 = 0 THEN 'NaN' ELSE (i % 300) * 1.25 END, i::int8 * 1000000000, CASE WHEN i % 11 = 0 THEN NULL ELSE 't' || (i % 5) END, CASE WHEN i % 17 = 0 THEN NULL ELSE 'c' || (i % 6) END FROM generate_series(1, 3000) i;
INSERT INTO df_u2 SELECT i, i % 5, (i % 400) / 7.0, i, CASE WHEN i % 13 = 0 THEN NULL ELSE 'v' || (i % 3) END, CASE WHEN i % 19 = 0 THEN NULL ELSE 'c' || (i % 4) END FROM generate_series(1, 2000) i;
CREATE TABLE df_up (k int, g int, a numeric(7,2)) DISTRIBUTED BY (k) PARTITION BY RANGE (g) (START (0) END (8) EVERY (4));
INSERT INTO df_up SELECT i, i % 8, i * 0.5 FROM generate_series(1, 1000) i;
ANALYZE df_u1;
ANALYZE df_u2;
ANALYZE df_up;
SET optimizer = off;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT u.g, count(*), sum(u.a) FROM (SELECT g, a FROM df_u1 UNION ALL SELECT g, a FROM df_u2) u GROUP BY u.g ORDER BY 1;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: df_u1.g
   ->  Sort
         Sort Key: df_u1.g
         ->  HashAggregate
               Group Key: df_u1.g
               ->  Redistribute Motion 3:3  (slice2; segments: 3)
                     Hash Key: df_u1.g
                     ->  Append
                           ->  Seq Scan on df_u1
                           ->  Seq Scan on df_u2
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible
(15 rows)

EXPLAIN (COSTS OFF) SELECT u.k, u.t, x.g FROM (SELECT k, t FROM df_u1 WHERE k < 50 UNION ALL SELECT k, t FROM df_u2 WHERE k < 50) u JOIN df_u1 x ON x.k = u.k + 1 ORDER BY 1, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: df_u1.k, df_u1.t
   ->  Sort
         Sort Key: df_u1.k, df_u1.t
         ->  Hash Join
               Hash Cond: (x.k = (df_u1.k + 1))
               ->  Seq Scan on df_u1 x
               ->  Hash
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: (df_u1.k + 1)
                           ->  Append
                                 ->  Seq Scan on df_u1
                                       Filter: (k < 50)
                                 ->  Subquery Scan on "*SELECT* 2"
                                       ->  Seq Scan on df_u2
                                             Filter: (k < 50)
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible
(20 rows)

EXPLAIN (COSTS OFF) SELECT g, sum(q), count(q) FROM (SELECT g, a / 3 q FROM df_u1 WHERE a <> 'NaN' UNION ALL SELECT g, a FROM df_u2 UNION ALL SELECT g, k * 1.5 FROM df_u1) u GROUP BY g ORDER BY 1;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: df_u1_1.g
   ->  Sort
         Sort Key: df_u1_1.g
         ->  Finalize HashAggregate
               Group Key: df_u1_1.g
               ->  Redistribute Motion 3:3  (slice2; segments: 3)
                     Hash Key: df_u1_1.g
                     ->  Streaming Partial HashAggregate
                           Group Key: df_u1_1.g
                           ->  Append
                                 ->  Seq Scan on df_u1 df_u1_1
                                       Filter: (a <> 'NaN'::numeric)
                                 ->  Seq Scan on df_u2
                                 ->  Seq Scan on df_u1
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(19 rows)

EXPLAIN (COSTS OFF) SELECT * FROM (SELECT k, a FROM df_u1 UNION ALL SELECT k, a FROM df_u2) u LIMIT 5;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Limit
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Limit
               ->  Append
                     ->  Seq Scan on df_u1
                     ->  Seq Scan on df_u2
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 not eligible: Append whose order of rows is read
(9 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM (SELECT g, b FROM df_u1 INTERSECT SELECT g, b FROM df_u2) s;
                                         QUERY PLAN                                         
--------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Subquery Scan on s
                     ->  HashSetOp Intersect
                           ->  Append
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: "*SELECT* 2".g, (("*SELECT* 2".b)::bigint)
                                       ->  Subquery Scan on "*SELECT* 2"
                                             ->  Seq Scan on df_u2
                                 ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                       Hash Key: "*SELECT* 1".g, "*SELECT* 1".b
                                       ->  Subquery Scan on "*SELECT* 1"
                                             ->  Seq Scan on df_u1
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible, sends Arrow batches
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible, sends Arrow batches
(19 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM (SELECT g, a FROM df_u1 INTERSECT SELECT g, a FROM df_u2) s;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Subquery Scan on s
                     ->  HashSetOp Intersect
                           ->  Append
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: "*SELECT* 1".g, "*SELECT* 1".a
                                       ->  Subquery Scan on "*SELECT* 1"
                                             ->  Seq Scan on df_u1
                                 ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                       Hash Key: "*SELECT* 2".g, "*SELECT* 2".a
                                       ->  Subquery Scan on "*SELECT* 2"
                                             ->  Seq Scan on df_u2
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 not eligible: INTERSECT or EXCEPT on a column of type numeric
 DataFusion: slice 2 eligible
 DataFusion: slice 3 eligible
(19 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM (SELECT g FROM df_u1 INTERSECT ALL SELECT g FROM df_u2) s;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Subquery Scan on s
                     ->  HashSetOp Intersect All
                           ->  Append
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: "*SELECT* 2".g
                                       ->  Subquery Scan on "*SELECT* 2"
                                             ->  Seq Scan on df_u2
                                 ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                       Hash Key: "*SELECT* 1".g
                                       ->  Subquery Scan on "*SELECT* 1"
                                             ->  Seq Scan on df_u1
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 not eligible: INTERSECT ALL or EXCEPT ALL
 DataFusion: slice 2 eligible
 DataFusion: slice 3 eligible
(19 rows)

EXPLAIN (COSTS OFF) SELECT count(*), count(c) FROM (SELECT g, c FROM df_u1 INTERSECT SELECT g + 1, c FROM df_u2) s;
                                       QUERY PLAN                                        
-----------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Subquery Scan on s
                     ->  HashSetOp Intersect
                           ->  Append
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: "*SELECT* 2"."?column?", "*SELECT* 2".c
                                       ->  Subquery Scan on "*SELECT* 2"
                                             ->  Seq Scan on df_u2
                                 ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                       Hash Key: "*SELECT* 1".g, "*SELECT* 1".c
                                       ->  Subquery Scan on "*SELECT* 1"
                                             ->  Seq Scan on df_u1
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible, sends Arrow batches
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible, sends Arrow batches
(19 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM (SELECT g, c::bpchar FROM df_u1 INTERSECT SELECT g, (c || 'x')::bpchar FROM df_u2) s;
                                     QUERY PLAN                                      
-------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Subquery Scan on s
                     ->  HashSetOp Intersect
                           ->  Append
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: "*SELECT* 2".g, "*SELECT* 2".bpchar
                                       ->  Subquery Scan on "*SELECT* 2"
                                             ->  Seq Scan on df_u2
                                 ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                       Hash Key: "*SELECT* 1".g, "*SELECT* 1".c
                                       ->  Subquery Scan on "*SELECT* 1"
                                             ->  Seq Scan on df_u1
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 not eligible: INTERSECT or EXCEPT on a column of type character
 DataFusion: slice 2 not eligible: type cast
 DataFusion: slice 3 eligible
(19 rows)

EXPLAIN (COSTS OFF) SELECT * FROM (SELECT k % 50 x, g y FROM df_u1 EXCEPT SELECT k % 40, g FROM df_u2) s ORDER BY 1, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.x, s.y
   ->  Sort
         Sort Key: s.x, s.y
         ->  Subquery Scan on s
               ->  HashSetOp Except
                     ->  Append
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: "*SELECT* 1".x, "*SELECT* 1".y
                                 ->  Subquery Scan on "*SELECT* 1"
                                       ->  Seq Scan on df_u1
                           ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                 Hash Key: "*SELECT* 2"."?column?", "*SELECT* 2".g
                                 ->  Subquery Scan on "*SELECT* 2"
                                       ->  Seq Scan on df_u2
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible, sends Arrow batches
(20 rows)

EXPLAIN (COSTS OFF) SELECT * FROM (SELECT t FROM df_u1 EXCEPT SELECT t FROM df_u2) s ORDER BY 1;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.t
   ->  Sort
         Sort Key: s.t
         ->  Subquery Scan on s
               ->  HashSetOp Except
                     ->  Append
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: "*SELECT* 1".t
                                 ->  Subquery Scan on "*SELECT* 1"
                                       ->  Seq Scan on df_u1
                           ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                 Hash Key: (("*SELECT* 2".t)::text)
                                 ->  Subquery Scan on "*SELECT* 2"
                                       ->  Seq Scan on df_u2
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible
 DataFusion: slice 3 eligible
(20 rows)

SET enable_hashagg = off;
EXPLAIN (COSTS OFF) SELECT g, sum(s) FROM (SELECT g, sum(a) s FROM df_u1 GROUP BY g UNION ALL SELECT g, sum(a) FROM df_u2 GROUP BY g) u GROUP BY g ORDER BY 2, 1;
                            QUERY PLAN                            
------------------------------------------------------------------
 Sort
   Sort Key: (sum((sum(df_u1.a)))), df_u1.g
   ->  GroupAggregate
         Group Key: df_u1.g
         ->  Merge Append
               Sort Key: df_u1.g
               ->  Finalize GroupAggregate
                     Group Key: df_u1.g
                     ->  Gather Motion 3:1  (slice1; segments: 3)
                           Merge Key: df_u1.g
                           ->  Partial GroupAggregate
                                 Group Key: df_u1.g
                                 ->  Sort
                                       Sort Key: df_u1.g
                                       ->  Seq Scan on df_u1
               ->  Finalize GroupAggregate
                     Group Key: df_u2.g
                     ->  Gather Motion 3:1  (slice2; segments: 3)
                           Merge Key: df_u2.g
                           ->  Partial GroupAggregate
                                 Group Key: df_u2.g
                                 ->  Sort
                                       Sort Key: df_u2.g
                                       ->  Seq Scan on df_u2
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible, sends Arrow batches
 DataFusion: slice 2 eligible, sends Arrow batches
(28 rows)

RESET enable_hashagg;
SET datafusion.mode = off;
