--
-- Window functions (WIN1): row_number, rank, dense_rank, and count, sum,
-- min and max over the whole partition, up to the current row's peers, or
-- up to the current row.  DataFusion sorts the rows by the partition and
-- order keys itself, in the order PostgreSQL sorts them by.  avg of numeric
-- and of integers (WIN2), as numeric_avg divides the frame's sum by its
-- count, with its display scale.  Each query runs with datafusion.mode off,
-- then on; the two results must match.
--
CREATE EXTENSION datafusion_executor;
ALTER DATABASE contrib_regression SET session_preload_libraries = 'datafusion_executor';
\c
SET datafusion.worker_threads = 2;
SET datafusion.motion_batches = on;
-- g and a with NULLs, a with ties; f with -0, 0 and NaN; m with NaN; c of
-- one value padded two ways, as an expression without a length makes it.
CREATE TABLE df_w (k int, g int, a int, b int8, n numeric(10,2), m numeric(10,2),
  f float8, t text) DISTRIBUTED BY (k);
INSERT INTO df_w SELECT i, CASE WHEN i % 13 = 0 THEN NULL ELSE i % 7 END,
  CASE WHEN i % 17 = 0 THEN NULL ELSE i % 3 END, 4000000000000000000 + i,
  (i % 211) * 0.75, CASE WHEN i % 97 = 0 THEN 'NaN' ELSE (i % 89) * 0.5 END,
  CASE i % 5 WHEN 0 THEN '-0'::float8 WHEN 1 THEN 0 WHEN 2 THEN 'NaN' ELSE i % 3 END,
  'v' || (i % 4)
  FROM generate_series(1, 3000) i;
ANALYZE df_w;
-- Supported: a Sort below the WindowAgg is left out, and where its rows
-- leave in their order (to a merging Motion, or the result), DataFusion
-- sorts them by its keys; a window below a join is a node of the plan; the
-- top WindowAgg leaves out the rows that fail its run condition.
SET optimizer = off;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT g, a, k, rank() OVER (PARTITION BY g ORDER BY a) FROM df_w ORDER BY 1, 2, 3;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g, a, k
   ->  Sort
         Sort Key: g, a, k
         ->  WindowAgg
               Partition By: g
               Order By: a
               ->  Sort
                     Sort Key: g, a
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: g
                           ->  Seq Scan on df_w
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(16 rows)

EXPLAIN (COSTS OFF) SELECT g, a, sum(n) * 100 / sum(sum(n)) OVER (PARTITION BY g) FROM df_w WHERE a < 3 GROUP BY g, a ORDER BY 1, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g, a
   ->  Sort
         Sort Key: g, a
         ->  WindowAgg
               Partition By: g
               ->  Sort
                     Sort Key: g
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: g
                           ->  Finalize HashAggregate
                                 Group Key: g, a
                                 ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                       Hash Key: g, a
                                       ->  Streaming Partial HashAggregate
                                             Group Key: g, a
                                             ->  Seq Scan on df_w
                                                   Filter: (a < 3)
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible, sends Arrow batches
(23 rows)

EXPLAIN (COSTS OFF) SELECT x.k, x.r, y.r FROM (SELECT k, rank() OVER (ORDER BY a, k) r FROM df_w WHERE k < 40) x JOIN (SELECT k, rank() OVER (ORDER BY b DESC) r FROM df_w WHERE k < 40) y ON x.r = y.r ORDER BY 1;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Sort
   Sort Key: df_w.k
   ->  Hash Join
         Hash Cond: ((rank() OVER (?)) = y.r)
         ->  WindowAgg
               Order By: df_w.a, df_w.k
               ->  Gather Motion 3:1  (slice1; segments: 3)
                     Merge Key: df_w.a, df_w.k
                     ->  Sort
                           Sort Key: df_w.a, df_w.k
                           ->  Seq Scan on df_w
                                 Filter: (k < 40)
         ->  Hash
               ->  Subquery Scan on y
                     ->  WindowAgg
                           Order By: df_w_1.b
                           ->  Gather Motion 3:1  (slice2; segments: 3)
                                 Merge Key: df_w_1.b
                                 ->  Sort
                                       Sort Key: df_w_1.b DESC
                                       ->  Seq Scan on df_w df_w_1
                                             Filter: (k < 40)
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible, sends Arrow batches
 DataFusion: slice 2 eligible, sends Arrow batches
(26 rows)

EXPLAIN (COSTS OFF) SELECT * FROM (SELECT g, k, rank() OVER (PARTITION BY g ORDER BY a DESC, k) r FROM df_w) s WHERE r <= 3 ORDER BY 1, 3, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.g, s.r, s.k
   ->  Sort
         Sort Key: s.g, s.r, s.k
         ->  Subquery Scan on s
               ->  WindowAgg
                     Run Condition: (rank() OVER (?) <= 3)
                     Partition By: df_w.g
                     Order By: df_w.a, df_w.k
                     ->  Sort
                           Sort Key: df_w.g, df_w.a DESC, df_w.k
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: df_w.g
                                 ->  Seq Scan on df_w
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(18 rows)

EXPLAIN (COSTS OFF) SELECT g, k, avg(n) OVER (PARTITION BY g ORDER BY k) * 2 + 1 FROM df_w ORDER BY 3, 1, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: (((avg(n) OVER (?) * '2'::numeric) + '1'::numeric)), g, k
   ->  Sort
         Sort Key: (((avg(n) OVER (?) * '2'::numeric) + '1'::numeric)), g, k
         ->  WindowAgg
               Partition By: g
               Order By: k
               ->  Sort
                     Sort Key: g, k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: g
                           ->  Seq Scan on df_w
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(16 rows)

EXPLAIN (COSTS OFF) SELECT * FROM (SELECT g, k, sum(a) OVER (PARTITION BY g ORDER BY k ROWS UNBOUNDED PRECEDING) s FROM df_w) x WHERE s > 10 ORDER BY g, k LIMIT 20;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Limit
   ->  Gather Motion 3:1  (slice1; segments: 3)
         Merge Key: x.g, x.k
         ->  Limit
               ->  Subquery Scan on x
                     Filter: (x.s > 10)
                     ->  WindowAgg
                           Partition By: df_w.g
                           Order By: df_w.k
                           ->  Sort
                                 Sort Key: df_w.g, df_w.k
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: df_w.g
                                       ->  Seq Scan on df_w
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(18 rows)

