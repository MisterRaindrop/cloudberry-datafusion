-- Not supported: avg, other window functions, min and max of floats (of
-- -0 and 0, PostgreSQL's keep the later), other frames, FILTER; a run
-- condition below the top WindowAgg.
SET optimizer = off;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT g, avg(n) OVER (PARTITION BY g) FROM df_w ORDER BY 1, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g, (avg(n) OVER (?))
   ->  Sort
         Sort Key: g, (avg(n) OVER (?))
         ->  WindowAgg
               Partition By: g
               ->  Sort
                     Sort Key: g
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: g
                           ->  Seq Scan on df_w
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 not eligible: window function avg
 DataFusion: slice 2 eligible
(15 rows)

EXPLAIN (COSTS OFF) SELECT g, k, ntile(3) OVER (PARTITION BY g ORDER BY k) FROM df_w ORDER BY 1, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g, k
   ->  WindowAgg
         Partition By: g
         Order By: k
         ->  Sort
               Sort Key: g, k
               ->  Redistribute Motion 3:3  (slice2; segments: 3)
                     Hash Key: g
                     ->  Seq Scan on df_w
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 not eligible: window function ntile
 DataFusion: slice 2 eligible
(14 rows)

