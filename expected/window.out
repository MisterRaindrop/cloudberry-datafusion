-- A window over whole partitions holds all its rows, within work_mem by
-- the planner's estimate; one up to the current row does not.
SET work_mem = '64kB';
EXPLAIN (COSTS OFF) SELECT g, k, t, n, m, f, b, sum(a) OVER (PARTITION BY g) FROM df_w ORDER BY 1, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g, k
   ->  Sort
         Sort Key: g, k
         ->  WindowAgg
               Partition By: g
               ->  Sort
                     Sort Key: g
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: g
                           ->  Seq Scan on df_w
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 not eligible: window over whole partitions of about 88 kB exceeds its 64 kB
 DataFusion: slice 2 eligible
(15 rows)

EXPLAIN (COSTS OFF) SELECT g, k, t, n, m, f, b, sum(a) OVER (PARTITION BY g ORDER BY k) FROM df_w ORDER BY 1, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g, k
   ->  WindowAgg
         Partition By: g
         Order By: k
         ->  Sort
               Sort Key: g, k
               ->  Redistribute Motion 3:3  (slice2; segments: 3)
                     Hash Key: g
                     ->  Seq Scan on df_w
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(14 rows)

RESET work_mem;
RESET datafusion.mode;
DROP TABLE df_w;
ALTER DATABASE contrib_regression RESET session_preload_libraries;
DROP EXTENSION datafusion_executor;
