-- GPORCA's plans
SET optimizer = on;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT g, a, k, rank() OVER (PARTITION BY g ORDER BY a) FROM df_w ORDER BY 1, 2, 3;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g, a, k
   ->  Sort
         Sort Key: g, a, k
         ->  WindowAgg
               Partition By: g
               Order By: a
               ->  Sort
                     Sort Key: g, a
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: g
                           ->  Seq Scan on df_w
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(16 rows)

EXPLAIN (COSTS OFF) SELECT g, a, sum(n) * 100 / sum(sum(n)) OVER (PARTITION BY g) FROM df_w WHERE a < 3 GROUP BY g, a ORDER BY 1, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g, a
   ->  Result
         ->  Sort
               Sort Key: g, a
               ->  WindowAgg
                     Partition By: g
                     ->  Sort
                           Sort Key: g
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: g
                                 ->  Finalize HashAggregate
                                       Group Key: g, a
                                       ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                             Hash Key: g, a
                                             ->  Streaming Partial HashAggregate
                                                   Group Key: g, a
                                                   ->  Seq Scan on df_w
                                                         Filter: (a < 3)
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
 DataFusion: slice 3 eligible, sends Arrow batches
(24 rows)

EXPLAIN (COSTS OFF) SELECT x.k, x.r, y.r FROM (SELECT k, rank() OVER (ORDER BY a, k) r FROM df_w WHERE k < 40) x JOIN (SELECT k, rank() OVER (ORDER BY b DESC) r FROM df_w WHERE k < 40) y ON x.r = y.r ORDER BY 1;
                            QUERY PLAN                            
------------------------------------------------------------------
 Sort
   Sort Key: df_w.k
   ->  Hash Join
         Hash Cond: ((rank() OVER (?)) = (rank() OVER (?)))
         ->  WindowAgg
               Order By: df_w.a, df_w.k
               ->  Gather Motion 3:1  (slice1; segments: 3)
                     Merge Key: df_w.a, df_w.k
                     ->  Sort
                           Sort Key: df_w.a, df_w.k
                           ->  Seq Scan on df_w
                                 Filter: (k < 40)
         ->  Hash
               ->  WindowAgg
                     Order By: df_w_1.b
                     ->  Gather Motion 3:1  (slice2; segments: 3)
                           Merge Key: df_w_1.b
                           ->  Sort
                                 Sort Key: df_w_1.b DESC
                                 ->  Seq Scan on df_w df_w_1
                                       Filter: (k < 40)
 Optimizer: GPORCA
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible, sends Arrow batches
 DataFusion: slice 2 eligible, sends Arrow batches
(25 rows)

EXPLAIN (COSTS OFF) SELECT * FROM (SELECT g, k, rank() OVER (PARTITION BY g ORDER BY a DESC, k) r FROM df_w) s WHERE r <= 3 ORDER BY 1, 3, 2;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: g, (rank() OVER (?)), k
   ->  Sort
         Sort Key: g, (rank() OVER (?)), k
         ->  Result
               Filter: ((rank() OVER (?)) <= 3)
               ->  WindowAgg
                     Partition By: g
                     Order By: a, k
                     ->  Sort
                           Sort Key: g, a DESC, k
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: g
                                 ->  Seq Scan on df_w
 Optimizer: GPORCA
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
