SELECT a % 1000, count(*), sum(a / (a - a)) FROM df_bat GROUP BY a % 1000;
ERROR:  division by zero  (seg0 slice1 172.17.0.3:40000 pid=35575)
-- Parallel mode: each segment's receiving worker comes from the hash too.
SET enable_parallel = on;
SET max_parallel_workers_per_gather = 2;
SET enable_groupagg = off;
EXPLAIN (COSTS OFF) SELECT e, count(*), sum(a) FROM df_bat GROUP BY e;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   ->  Finalize HashAggregate
         Group Key: e
         ->  Redistribute Motion 6:6  (slice2; segments: 6)
               Hash Key: e
               Hash Module: 3
               ->  Partial HashAggregate
                     Group Key: e
                     ->  Parallel Seq Scan on df_bat
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(13 rows)

SET datafusion.mode = off;
SELECT e, count(*), sum(a), max(c) FROM df_bat WHERE e < 5 GROUP BY e;
 e | count |    sum    |   max    
---+-------+-----------+----------
 0 |  2000 | 200100000 |    50000
 1 |  2000 | 199902000 | 49975.25
 4 |  2000 | 199908000 |    49976
 3 |  2000 | 199906000 | 49975.75
 2 |  2000 | 199904000 |  49975.5
(5 rows)

SET datafusion.mode = on;
SELECT e, count(*), sum(a), max(c) FROM df_bat WHERE e < 5 GROUP BY e;
 e | count |    sum    |   max    
---+-------+-----------+----------
 2 |  2000 | 199904000 |  49975.5
 4 |  2000 | 199908000 |    49976
 3 |  2000 | 199906000 | 49975.75
 0 |  2000 | 200100000 |    50000
 1 |  2000 | 199902000 | 49975.25
(5 rows)

RESET enable_parallel;
RESET max_parallel_workers_per_gather;
RESET enable_groupagg;
-- Split avg (M7d): through batch Motions the partial stage passes sum and
-- count, and the combining stage divides their sums; without batches avg
-- stays on PostgreSQL.  The values are exact in binary, so the order of the
-- additions does not show.
CREATE TABLE df_bat_avg (a int4, f real, c float8, e int2) DISTRIBUTED BY (a);
INSERT INTO df_bat_avg SELECT i, (i % 977) / 8.0, i / 4.0, (i % 100)::int2
FROM generate_series(1, 200000) i;
INSERT INTO df_bat_avg VALUES (NULL, NULL, NULL, NULL), (200001, NULL, NULL, 7);
ANALYZE df_bat_avg;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT avg(c), avg(f) FROM df_bat_avg;
                    QUERY PLAN                     
---------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on df_bat_avg
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible, sends Arrow batches
(7 rows)

EXPLAIN (COSTS OFF) SELECT e, avg(c) FROM df_bat_avg GROUP BY e;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Finalize HashAggregate
         Group Key: e
         ->  Redistribute Motion 3:3  (slice2; segments: 3)
               Hash Key: e
               ->  Streaming Partial HashAggregate
                     Group Key: e
                     ->  Seq Scan on df_bat_avg
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(12 rows)

SET datafusion.motion_batches = off;
EXPLAIN (COSTS OFF) SELECT avg(c), avg(f) FROM df_bat_avg;
                                   QUERY PLAN                                    
---------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on df_bat_avg
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: combining aggregate avg without batch Motions
 DataFusion: slice 1 not eligible: partial aggregate avg without batch Motions
(7 rows)

SET datafusion.motion_batches = on;
EXPLAIN (COSTS OFF) SELECT avg(a) FROM df_bat_avg;
                    QUERY PLAN                     
---------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on df_bat_avg
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 eligible
 DataFusion: slice 1 eligible, sends Arrow batches
(7 rows)

SET datafusion.mode = off;
