-- A sorted rollup whose order no one reads, as the first of two stages,
-- runs hashed without its Sort (D2).
RESET gp_enable_multiphase_agg;
SET datafusion.mode = explain;
EXPLAIN (COSTS OFF) SELECT a, b, sum(n), count(*), grouping(a, b) FROM df_gs GROUP BY ROLLUP (a, b) ORDER BY 1, 2, 5;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: a, b, (GROUPING(a, b))
   ->  Sort
         Sort Key: a, b, (GROUPING(a, b))
         ->  Finalize GroupAggregate
               Group Key: a, b, (GROUPINGSET_ID())
               ->  Sort
                     Sort Key: a, b, (GROUPINGSET_ID())
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: a, b, (GROUPINGSET_ID())
                           ->  Partial GroupAggregate
                                 Group Key: a, b
                                 Group Key: a
                                 Group Key: ()
                                 ->  Sort
                                       Sort Key: a, b
                                       ->  Seq Scan on df_gs
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(21 rows)

EXPLAIN (COSTS OFF) SELECT a, b, count(*) FROM df_gs GROUP BY ROLLUP (a, b) ORDER BY a NULLS FIRST, b, 3 LIMIT 8;
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Limit
   ->  Gather Motion 3:1  (slice1; segments: 3)
         Merge Key: a, b, (count(*))
         ->  Limit
               ->  Sort
                     Sort Key: a NULLS FIRST, b, (count(*))
                     ->  Finalize GroupAggregate
                           Group Key: a, b, (GROUPINGSET_ID())
                           ->  Sort
                                 Sort Key: a, b, (GROUPINGSET_ID())
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: a, b, (GROUPINGSET_ID())
                                       ->  Partial GroupAggregate
                                             Group Key: a, b
                                             Group Key: a
                                             Group Key: ()
                                             ->  Sort
                                                   Sort Key: a, b
                                                   ->  Seq Scan on df_gs
 Optimizer: Postgres query optimizer
 DataFusion: slice 0 not eligible: receives rows from a Gather Motion with nothing to compute on them
 DataFusion: slice 1 eligible
 DataFusion: slice 2 eligible, sends Arrow batches
(23 rows)

