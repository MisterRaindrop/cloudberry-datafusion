+// A cache entry mapped read-only.
+class Mapped {
+ public:
+  enum Status { kMissing, kBad, kOk };
+  Mapped() = default;
+  Mapped(const Mapped &) = delete;
+  Mapped &operator=(const Mapped &) = delete;
+  ~Mapped() {
+    if (p_) munmap(p_, n_);
+  }
+  // kBad: the file is there but is no entry
+  Status Open(const std::string &path) {
+    int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return kMissing;
+    struct stat st;
+    if (fstat(fd, &st) != 0) {
+      close(fd);
+      return kMissing;
+    }
+    if (st.st_size < static_cast<off_t>(sizeof(CacheHeader))) {
+      close(fd);
+      return kBad;
+    }
+    void *m = mmap(nullptr, static_cast<size_t>(st.st_size), PROT_READ,
+                   MAP_SHARED | MAP_POPULATE, fd, 0);
+    close(fd);
+    if (m == MAP_FAILED) return kMissing;
+    p_ = m;
+    n_ = static_cast<size_t>(st.st_size);
+    if (header()->magic != kCacheMagic) {
+      munmap(p_, n_);
+      p_ = nullptr;
+      n_ = 0;
+      return kBad;
+    }
+    return kOk;
+  }
+  const char *data() const { return static_cast<const char *>(p_); }
+  size_t size() const { return n_; }
+  const CacheHeader *header() const {
+    return reinterpret_cast<const CacheHeader *>(p_);
+  }
+
+ private:
+  void *p_ = nullptr;
+  size_t n_ = 0;
+};
+
+// Removes entry 'path', which does not fit what it should hold.
+void DropBad(const std::string &path) {
+  if (unlink(path.c_str()) == 0) g_cache.bad++;
+}
+
+// Whether the header-only entry 'm' (n, g<group>) is sound.
+bool CheckSmall(const Mapped &m, uint64_t max_rows) {
+  const CacheHeader *h = m.header();
+  return m.size() == sizeof(CacheHeader) && h->rows <= max_rows &&
+         h->row_offset + h->rows <= UINT32_MAX && h->width == 0 &&
+         h->stored == 0 && h->has_nulls == 0 && h->pad == 0;
+}
+
+enum class Fit { kYes, kNo, kUncacheable };
+
+// Whether column entry 'm' holds a column of 'rows' rows read at 'width',
+// laid out as BuildEntry lays it out: sizes, offsets and all.
+Fit CheckColumn(const Mapped &m, size_t rows, int width) {
+  const CacheHeader *h = m.header();
+  if (h->stored == kUncacheable)
+    return m.size() == sizeof(CacheHeader) && h->rows == rows ? Fit::kUncacheable
+                                                              : Fit::kNo;
+  if (h->rows != rows || h->width != width || h->has_nulls > 1 || h->pad != 0)
+    return Fit::kNo;
+  const size_t head = sizeof(CacheHeader) + (h->has_nulls ? Pad8(rows) : 0);
+  if (width > 0) {
+    if (h->stored != width && !(width == 16 && h->stored == 8)) return Fit::kNo;
+    return m.size() == head + rows * static_cast<size_t>(h->stored) ? Fit::kYes
+                                                                    : Fit::kNo;
+  }
+  if (h->stored != width) return Fit::kNo;
+  const size_t offs_bytes = Pad8((rows + 1) * sizeof(uint32_t));
+  if (m.size() < head + offs_bytes) return Fit::kNo;
+  const uint32_t *offs = reinterpret_cast<const uint32_t *>(m.data() + head);
+  if (offs[0] != 0) return Fit::kNo;
+  for (size_t r = 0; r < rows; r++)
+    if (offs[r + 1] < offs[r]) return Fit::kNo;
+  return m.size() - head - offs_bytes == offs[rows] ? Fit::kYes : Fit::kNo;
+}
+
+// Writes an entry: to a file of its own first, renamed into place, so that
+// readers see all of it or none.  Failures leave no entry.
+bool WriteEntry(const std::string &path, const std::vector<char> &bytes) {
+  char tmp_suffix[64];
+  snprintf(tmp_suffix, sizeof(tmp_suffix), ".tmp%d_%lx", static_cast<int>(getpid()),
+           static_cast<unsigned long>(pthread_self()));
+  const std::string tmp = path + tmp_suffix;
+  int fd = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+  if (fd < 0) return false;
+  size_t done = 0;
+  while (done < bytes.size()) {
+    ssize_t w = write(fd, bytes.data() + done, bytes.size() - done);
+    if (w < 0 && errno == EINTR) continue;
+    if (w <= 0) break;
+    done += static_cast<size_t>(w);
+  }
+  close(fd);
+  if (done != bytes.size() || rename(tmp.c_str(), path.c_str()) != 0) {
+    unlink(tmp.c_str());
+    return false;
+  }
+  return true;
+}
