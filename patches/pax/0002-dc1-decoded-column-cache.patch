+// DC1: a cache of decoded columns, as files read through mmap, under the
+// directory datafusion.pax_decode_cache names (cache_config).  A group's
+// column is kept as read_block hands it out, a slot a row: fixed-width
+// values converted (16-byte ones that all fit 8 bytes narrowed), strings
+// without their headers.  Each micro-partition has a directory of its own,
+// named by its file's device, inode, size and modification time, so that a
+// rewritten file misses.  In it:
+//   n                                  the file's number of groups
+//   g<group>                           the group's rows, their offset
+//   g<group>_c<col>_w<width>_s<scale>  a column of the group read so
+// Entries are written to a file of their own and renamed into place.  They
+// are checked against what the group needs before use (CheckColumn); one
+// that does not fit is removed, so that the next read rebuilds it.  A column
+// that cannot be cached (toast left, strings past the offsets' range) gets
+// an entry of a header only marked kUncacheable, so that it is not tried
+// again.  The size is kept to the limit by CacheAdmit and CacheSweep.
+constexpr uint64_t kCacheMagic = 0x32434644ULL;  // "DFC2"
+constexpr int32_t kUncacheable = INT32_MIN;
+// what an entry's header may say: PAX groups have far fewer rows, files
+// far fewer groups
+constexpr uint64_t kCacheMaxRows = uint64_t{1} << 30;
+constexpr uint64_t kCacheMaxGroups = uint64_t{1} << 24;
+
+struct CacheHeader {
+  uint64_t magic;
+  uint64_t rows;        // n: the number of groups
+  uint64_t row_offset;
+  int32_t width;        // the width asked for: <= 0 strings
+  int32_t stored;       // fixed-width: a slot's bytes; strings: width
+  uint32_t has_nulls;   // a byte a row follows the header, padded to 8
+  uint32_t pad;
+};
+
+// What the cache did in this process, for datafusion_debug_pax_cache().
+struct CacheCounters {
+  std::atomic<int64_t> hits{0};      // groups read from the cache
+  std::atomic<int64_t> fills{0};     // entries written
+  std::atomic<int64_t> bad{0};       // entries that did not fit, removed
+  std::atomic<int64_t> evicted{0};   // micro-partitions removed by sweeps
+  std::atomic<int64_t> refused{0};   // groups not cached: the cache was full
+  std::atomic<int64_t> unusable{0};  // scans whose directory was unusable
+};
+CacheCounters g_cache;
+
+size_t Pad8(size_t n) { return (n + 7) / 8 * 8; }
+
+int64_t NowSeconds() { return static_cast<int64_t>(time(nullptr)); }
+
+// The directory of the cache entries of micro-partition 'file', or "".
+std::string CacheKey(const std::string &dir, const std::string &file) {
+  struct stat st;
+  if (stat(file.c_str(), &st) != 0) return "";
+  char buf[128];
+  snprintf(buf, sizeof(buf), "/%llx_%llx_%lld_%lld",
+           static_cast<unsigned long long>(st.st_dev),
+           static_cast<unsigned long long>(st.st_ino),
+           static_cast<long long>(st.st_size),
+           static_cast<long long>(st.st_mtim.tv_sec) * 1000000000LL +
+               static_cast<long long>(st.st_mtim.tv_nsec));
+  return dir + buf;
+}
+
+// Whether 'name' is a micro-partition directory's, as CacheKey makes them.
+bool IsKeyName(const char *name) {
+  int seps = 0;
+  for (const char *p = name; *p; p++) {
+    if (*p == '_')
+      seps++;
+    else if (!((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f')))
+      return false;
+  }
+  return seps == 3;
+}
