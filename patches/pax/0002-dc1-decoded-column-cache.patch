+// Looks group 'g' up in the cache: its entry and those of all its columns
+// but the late ones ('maps'), or false.  Entries that do not fit are
+// removed, all of the group's: the miss rebuilds them at once.
+bool LookupGroup(const DfScan *scan, const std::string &key, size_t g,
+                 Mapped &meta, std::vector<Mapped> &maps) {
+  const std::string group_path = GroupEntry(key, g);
+  switch (meta.Open(group_path)) {
+    case Mapped::kMissing:
+      return false;
+    case Mapped::kBad:
+      DropBad(group_path);
+      return false;
+    case Mapped::kOk:
+      break;
+  }
+  if (!CheckSmall(meta, kCacheMaxRows)) {
+    DropBad(group_path);
+    return false;
+  }
+  const size_t rows = meta.header()->rows;
+  bool hit = true;
+  bool bad = false;
+  for (size_t k = 0; k < scan->cols.size() && (hit || bad); k++) {
+    if (scan->late[k]) continue;
+    const std::string path =
+        ColumnEntry(key, g, scan->cols[k], scan->widths[k], scan->scales[k]);
+    switch (maps[k].Open(path)) {
+      case Mapped::kMissing:
+        hit = false;
+        continue;
+      case Mapped::kBad:
+        DropBad(path);
+        hit = false;
+        bad = true;
+        continue;
+      case Mapped::kOk:
+        break;
+    }
+    switch (CheckColumn(maps[k], rows, scan->widths[k])) {
+      case Fit::kYes:
+        break;
+      case Fit::kUncacheable:
+        hit = false;
+        break;
+      case Fit::kNo:
+        DropBad(path);
+        hit = false;
+        bad = true;
+        break;
+    }
+  }
+  return hit;
+}
+
+// Puts the columns of group 'g' of 'rows' rows at 'row_offset', decoded
+// into 'colv', in the cache: those it lacks, then the group's entry, as far
+// as CacheAdmit lets them in.
+void FillGroup(const DfScan *scan, const std::string &key, size_t g,
+               const std::vector<pax::PaxColumn *> &colv, size_t rows,
+               size_t row_offset) {
+  if (!CacheAdmit(scan, 0)) {
+    g_cache.refused++;
+    return;
+  }
+  if (mkdir(key.c_str(), 0700) != 0 && errno != EEXIST) return;
+  std::vector<char> bytes;
+  for (size_t k = 0; k < scan->cols.size(); k++) {
+    if (scan->late[k]) continue;
+    const std::string path =
+        ColumnEntry(key, g, scan->cols[k], scan->widths[k], scan->scales[k]);
+    if (access(path.c_str(), F_OK) == 0) continue;
+    ColState st{};
+    st.width = scan->widths[k];
+    st.scale = scan->scales[k];
+    InitCol(st, colv[k], rows);
+    if (!BuildEntry(st, rows, row_offset, bytes))
+      bytes = SmallEntry(rows, row_offset, scan->widths[k], kUncacheable);
+    if (!CacheAdmit(scan, static_cast<int64_t>(bytes.size()))) {
+      g_cache.refused++;
+      return;
+    }
+    if (WriteEntry(path, bytes)) g_cache.fills++;
+  }
+  const std::string group_path = GroupEntry(key, g);
+  if (access(group_path.c_str(), F_OK) != 0 &&
+      CacheAdmit(scan, sizeof(CacheHeader)) &&
+      WriteEntry(group_path, SmallEntry(rows, row_offset, 0, 0)))
+    g_cache.fills++;
+}
+
+// The number of groups of the micro-partition of cache directory 'key':
+// from its n entry, else -1.
+int64_t CachedGroupCount(const std::string &key) {
+  const std::string path = key + "/n";
+  Mapped m;
+  switch (m.Open(path)) {
+    case Mapped::kMissing:
+      return -1;
+    case Mapped::kBad:
+      DropBad(path);
+      return -1;
+    case Mapped::kOk:
+      break;
+  }
+  if (!CheckSmall(m, kCacheMaxGroups) || m.header()->row_offset != 0) {
+    DropBad(path);
+    return -1;
+  }
+  return static_cast<int64_t>(m.header()->rows);
+}
