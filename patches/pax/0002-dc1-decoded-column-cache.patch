+template <typename T>
+void Append(std::vector<char> &out, const T *p, size_t n) {
+  const char *b = reinterpret_cast<const char *>(p);
+  out.insert(out.end(), b, b + n * sizeof(T));
+}
+
+// The cache's size.  Its bytes on disk are measured by sweeps (CacheSweep),
+// of every micro-partition directory, by one process at a time (the one
+// holding an exclusive lock on the file .sweep), at most once every
+// kSweepEvery seconds; the total goes into .sweep for the others.  A
+// process sweeps when it does not know the total or has written a 512th of
+// the limit (16 MB at least) since: what processes write between sweeps
+// goes past the limit, a few percent of it with a few dozen processes.
+// Writers count their entries in blocks of 4 kB, as the disk holds them.  A sweep finding more
+// than the limit removes micro-partitions unused for kIdleSeconds, least
+// recently used first, down to 90% of it; a directory is used when an
+// entry is written into it or a group is read from it (read_block touches
+// it, once a minute at most).  Writers add no entry while the last total
+// plus what they wrote since reaches the limit: a working set bigger than
+// the cache keeps what it has, where evicting would make the next scan miss
+// everything.  Writers' files a crash left are removed after an hour.
+constexpr int64_t kSweepEvery = 5;
+constexpr int64_t kIdleSeconds = 600;
+constexpr uint64_t kSweepMagic = 0x57534644ULL;  // "DFSW"
+
+struct SweepRecord {
+  uint64_t magic;
+  int64_t total;  // bytes measured
+  int64_t when;   // seconds since the epoch
+};
+
+// This process's view of the cache's size.
+struct CacheUse {
+  std::mutex mu;
+  std::string dir;
+  int64_t total = -1;      // the last sweep's total, -1 unknown
+  int64_t when = 0;        // that sweep's time
+  int64_t written = 0;     // bytes this process wrote since
+  int64_t checked = 0;     // when .sweep was last read
+  bool sweeping = false;   // a thread of this process sweeps
+};
+CacheUse g_use;
+
+bool ReadSweep(int fd, SweepRecord *rec) {
+  return pread(fd, rec, sizeof(*rec), 0) == static_cast<ssize_t>(sizeof(*rec)) &&
+         rec->magic == kSweepMagic && rec->total >= 0;
+}
+
+// Removes micro-partition directory 'path' and its entries.
+void RemoveKeyDir(const std::string &path) {
+  DIR *d = opendir(path.c_str());
+  if (d == nullptr) return;
+  while (struct dirent *e = readdir(d)) {
+    if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
+    unlinkat(dirfd(d), e->d_name, 0);
+  }
+  closedir(d);
+  if (rmdir(path.c_str()) == 0) g_cache.evicted++;
+}
+
+// Measures the cache under 'dir' and trims it to 'limit' as described
+// above.  Returns the bytes it then holds.
+int64_t CacheSweep(const std::string &dir, int64_t limit) {
+  struct Item {
+    int64_t used;
+    int64_t bytes;
+    std::string path;
+  };
+  std::vector<Item> items;
+  int64_t total = 0;
+  const int64_t now = NowSeconds();
+  DIR *d = opendir(dir.c_str());
+  if (d == nullptr) return 0;
+  while (struct dirent *e = readdir(d)) {
+    if (!IsKeyName(e->d_name)) continue;
+    std::string path = dir + "/" + e->d_name;
+    struct stat ds;
+    if (lstat(path.c_str(), &ds) != 0 || !S_ISDIR(ds.st_mode)) continue;
+    int64_t bytes = static_cast<int64_t>(ds.st_blocks) * 512;
+    DIR *sd = opendir(path.c_str());
+    if (sd == nullptr) continue;
+    while (struct dirent *f = readdir(sd)) {
+      if (f->d_name[0] == '.') continue;
+      struct stat fs;
+      if (fstatat(dirfd(sd), f->d_name, &fs, AT_SYMLINK_NOFOLLOW) != 0) continue;
+      if (strstr(f->d_name, ".tmp") != nullptr && fs.st_mtime < now - 3600) {
+        unlinkat(dirfd(sd), f->d_name, 0);
+        continue;
+      }
+      bytes += static_cast<int64_t>(fs.st_blocks) * 512;
+    }
+    closedir(sd);
+    total += bytes;
+    items.push_back({static_cast<int64_t>(ds.st_mtime), bytes, std::move(path)});
+  }
+  closedir(d);
+  if (total > limit) {
+    std::sort(items.begin(), items.end(),
+              [](const Item &a, const Item &b) { return a.used < b.used; });
+    const int64_t target = limit / 10 * 9;
+    for (const Item &it : items) {
+      if (total <= target || it.used > now - kIdleSeconds) break;
+      RemoveKeyDir(it.path);
+      total -= it.bytes;
+    }
+  }
+  return total;
+}
+
+// Sweeps the cache under 'dir' if no process did for kSweepEvery seconds
+// and none sweeps now.  Fills 'rec' with the total then known.
+bool TrySweep(const std::string &dir, int64_t limit, SweepRecord *rec) {
+  int fd = open((dir + "/.sweep").c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+  if (fd < 0) return false;
+  bool known = false;
+  if (flock(fd, LOCK_EX | LOCK_NB) == 0) {
+    const int64_t now = NowSeconds();
+    if (ReadSweep(fd, rec) && rec->when > now - kSweepEvery) {
+      known = true;
+    } else {
+      *rec = SweepRecord{kSweepMagic, CacheSweep(dir, limit), NowSeconds()};
+      known = pwrite(fd, rec, sizeof(*rec), 0) == static_cast<ssize_t>(sizeof(*rec));
+    }
+    flock(fd, LOCK_UN);
+  }
+  close(fd);
+  return known;
+}
+
+// Whether 'bytes' more may go into the cache of 'scan': counted as written
+// if so.  Sweeps when it is this process's turn (see above).
+bool CacheAdmit(const DfScan *scan, int64_t bytes) {
+  std::unique_lock<std::mutex> lock(g_use.mu);
+  const int64_t now = NowSeconds();
+  if (g_use.dir != scan->cache_dir) {
+    g_use.dir = scan->cache_dir;
+    g_use.total = -1;
+    g_use.when = 0;
+    g_use.written = 0;
+    g_use.checked = 0;
+  }
+  if (now - g_use.checked >= 2) {
+    g_use.checked = now;
+    int fd = open((g_use.dir + "/.sweep").c_str(), O_RDONLY | O_CLOEXEC);
+    SweepRecord rec;
+    if (fd >= 0) {
+      if (ReadSweep(fd, &rec) && rec.when != g_use.when) {
+        g_use.total = rec.total;
+        g_use.when = rec.when;
+        g_use.written = 0;
+      }
+      close(fd);
+    }
+  }
+  const int64_t share = std::max<int64_t>(scan->cache_limit / 512, int64_t{16} << 20);
+  bytes = (bytes + 4095) / 4096 * 4096;
+  if ((g_use.total < 0 || g_use.written >= share) && !g_use.sweeping) {
+    g_use.sweeping = true;
+    const std::string dir = g_use.dir;
+    lock.unlock();
+    SweepRecord rec;
+    const bool known = TrySweep(dir, scan->cache_limit, &rec);
+    lock.lock();
+    g_use.sweeping = false;
+    if (known && g_use.dir == dir && rec.when != g_use.when) {
+      g_use.total = rec.total;
+      g_use.when = rec.when;
+      g_use.written = 0;
+    }
+  }
+  if (g_use.total < 0 || g_use.total + g_use.written + bytes > scan->cache_limit)
+    return false;
+  g_use.written += bytes;
+  return true;
 }
 
+// Marks micro-partition directory 'key' used, once a minute at most.
+void TouchKey(const std::string &key) {
+  struct stat st;
+  if (stat(key.c_str(), &st) == 0 && st.st_mtime < NowSeconds() - 60)
+    utimensat(AT_FDCWD, key.c_str(), nullptr, 0);
+}
+
+// Column 'st' as it is to be read from cache entry 'entry', which
+// CheckColumn found fit for a group of 'rows' rows.
+void SetCached(ColState &st, const char *entry, size_t rows) {
+  auto h = reinterpret_cast<const CacheHeader *>(entry);
+  const char *p = entry + sizeof(CacheHeader);
+  st.cached = true;
+  st.col = nullptr;
+  st.bm = nullptr;
+  st.cnulls = nullptr;
+  if (h->has_nulls) {
+    st.cnulls = reinterpret_cast<const uint8_t *>(p);
+    p += Pad8(rows);
+  }
+  st.coffs = nullptr;
+  st.cwidth = h->stored;
+  if (h->width <= 0) {
+    st.coffs = reinterpret_cast<const uint32_t *>(p);
+    p += Pad8((rows + 1) * sizeof(uint32_t));
+  }
+  st.cvals = p;
+}
+
+// The cache entry of column 'st' (decoded by PAX) of a group of 'rows'
+// rows at 'row_offset' in its file, or false when it is not cached.
+bool BuildEntry(const ColState &st, size_t rows, size_t row_offset,
+                std::vector<char> &out) {
+  CacheHeader h{kCacheMagic, rows, row_offset, st.width, st.width, 0, 0};
+  std::vector<uint8_t> nl(rows, 0);
+  std::vector<char> vals;
+  std::vector<uint32_t> offs;
+  char err[128];
+  if (st.width > 0) {
+    const int w = st.width;
+    vals.resize(rows * w);
+    for (size_t r = 0; r < rows; r++) {
+      const size_t i = !st.dense ? r : st.bm ? st.index[r] : r;
+      if (!ConvertFixed(st, r, i, vals.data() + r * w, &nl[r], err, sizeof(err)))
+        return false;
+    }
+    if (w == 16) {
+      bool narrow = true;
+      for (size_t r = 0; r < rows && narrow; r++) {
+        int64_t lo, hi;
+        std::memcpy(&lo, vals.data() + r * 16, 8);
+        std::memcpy(&hi, vals.data() + r * 16 + 8, 8);
+        narrow = hi == (lo < 0 ? -1 : 0);
+      }
+      if (narrow) {
+        for (size_t r = 0; r < rows; r++)
+          std::memmove(vals.data() + r * 8, vals.data() + r * 16, 8);
+        vals.resize(rows * 8);
+        h.stored = 8;
+      }
+    }
+  } else {
+    offs.reserve(rows + 1);
+    offs.push_back(0);
+    for (size_t r = 0; r < rows; r++) {
+      const bool present = !st.bm || st.bm->Test(static_cast<uint32>(r));
+      const size_t i = !st.dense ? r : st.bm ? st.index[r] : r;
+      if (present) {
+        if (st.vec_numeric) {
+          AppendVecNumeric(st.buf + i * 16, vals);
+        } else {
+          const struct varlena *v = reinterpret_cast<const struct varlena *>(
+              DatumGetPointer(st.col->GetDatum(i)));
+          if (VARATT_IS_EXTERNAL(v) || VARATT_IS_COMPRESSED(v)) return false;
+          vals.insert(vals.end(), VARDATA_ANY(v),
+                      VARDATA_ANY(v) + VARSIZE_ANY_EXHDR(v));
+        }
+      } else {
+        nl[r] = 1;
+      }
+      // chunks of the group are handed out in place: int32 offsets
+      if (vals.size() >= (size_t{1} << 30)) return false;
+      offs.push_back(static_cast<uint32_t>(vals.size()));
+    }
+  }
+  for (size_t r = 0; r < rows && !h.has_nulls; r++) h.has_nulls = nl[r];
+  out.clear();
+  Append(out, &h, 1);
+  if (h.has_nulls) {
+    Append(out, nl.data(), rows);
+    out.resize(out.size() + (8 - rows % 8) % 8, 0);
+  }
+  if (st.width <= 0) {
+    Append(out, offs.data(), offs.size());
+    out.resize(out.size() + (8 - offs.size() * 4 % 8) % 8, 0);
+  }
+  Append(out, vals.data(), vals.size());
+  return true;
+}
