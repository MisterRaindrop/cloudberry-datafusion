+// DatafusionPaxScanApi.cache_config
+void CacheConfig(void *scan_arg, const char *dir, int64_t limit) {
+  auto scan = static_cast<DfScan *>(scan_arg);
+  scan->cache_dir.clear();
+  scan->cache_limit = 0;
+  if (dir == nullptr || dir[0] == '\0' || limit <= 0) return;
+  struct stat st;
+  if ((mkdir(dir, 0700) != 0 && errno != EEXIST) || stat(dir, &st) != 0 ||
+      !S_ISDIR(st.st_mode) || access(dir, R_OK | W_OK | X_OK) != 0) {
+    g_cache.unusable++;
+    return;
+  }
+  scan->cache_dir = dir;
+  while (scan->cache_dir.size() > 1 && scan->cache_dir.back() == '/')
+    scan->cache_dir.pop_back();
+  scan->cache_limit = limit;
+}
