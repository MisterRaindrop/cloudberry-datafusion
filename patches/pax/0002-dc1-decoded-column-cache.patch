+// A header-only entry: n, g<group>, or a column's kUncacheable mark.
+std::vector<char> SmallEntry(uint64_t rows, uint64_t row_offset, int32_t width,
+                             int32_t stored) {
+  CacheHeader h{kCacheMagic, rows, row_offset, width, stored, 0, 0};
+  std::vector<char> bytes;
+  Append(bytes, &h, 1);
+  return bytes;
+}
