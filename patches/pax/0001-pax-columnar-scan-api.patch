+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ *
+ * datafusion_scan_api.h
+ *	  C interface for reading PAX micro-partitions column by column, for
+ *	  the datafusion_executor extension.
+ *
+ * The only exported symbol is datafusion_pax_scan_api(), which returns a
+ * table of functions; everything else stays local to the library, so the
+ * names cannot clash with PAX or PostgreSQL.  A caller checks 'version'
+ * before using the table.
+ *
+ * Threading contract:
+ *   - begin runs on the backend's main thread: listing the micro-partitions
+ *     visible to the snapshot reads PAX's auxiliary table, and skipping
+ *     them by min/max statistics calls PostgreSQL's comparison functions.
+ *     It copies what the readers need and keeps no PostgreSQL object.
+ *   - read_block may run on any thread, concurrently for different blocks
+ *     or different groups of one block.
+ *     It opens the block's files through PAX's LocalFileSystem (POSIX I/O),
+ *     decodes the projected columns with PAX's reader (malloc, C++
+ *     exceptions, no PostgreSQL calls) and hands out rows group by group.
+ *     The memory it holds meanwhile is reported through 'account'.
+ *   - end frees the scan from any thread, once no reader runs.
+ * No exception crosses these functions: failures come back as NULL or -1
+ * with a message.
+ *
+ * contrib/pax_storage/src/cpp/access/datafusion_scan_api.h
+ *
+ *-------------------------------------------------------------------------
+ */
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define DATAFUSION_PAX_SCAN_API_VERSION 5
+
+struct List;
+struct RelationData;
+struct SnapshotData;
+
+/* Rows of one group, or of part of it: one null byte per row (1 = null).
+ * A fixed-width column's values are packed at its width and 'offsets' is
+ * NULL; a string or numeric column's are the bytes of its values (without
+ * varlena headers, char(n) with its padding, a numeric as PostgreSQL's
+ * representation), row i at offsets[i]..offsets[i + 1], nrows + 1
+ * offsets. */
+typedef struct DatafusionPaxColumn {
+  const void *values;
+  const uint8_t *nulls;
+  const int32_t *offsets;
+} DatafusionPaxColumn;
+
+/* Called with a group's visible rows, at most 8192 at a time (fewer when
+ * their strings take more than 64 MB); non-zero stops the read. */
+typedef int (*DatafusionPaxEmit)(void *ctx, uint32_t nrows,
+                                 const DatafusionPaxColumn *cols);
+
+/* Called with the change in bytes the reader holds (decoded columns, read
+ * buffer, visibility map, handed-out rows); the deltas of one read_block
+ * call add up to zero by the time it returns. */
+typedef void (*DatafusionPaxAccount)(void *ctx, int64_t delta);
+
+/* What begin's min/max skipping did. */
+typedef struct DatafusionPaxScanInfo {
+  int64_t files;          /* micro-partitions visible to the snapshot */
+  int64_t files_skipped;  /* skipped by their statistics */
+  int64_t groups;         /* groups examined in the remaining files */
+  int64_t groups_skipped; /* skipped by their statistics */
+} DatafusionPaxScanInfo;
+
+typedef struct DatafusionPaxScanApi {
+  uint32_t version; /* DATAFUSION_PAX_SCAN_API_VERSION */
+  /* GNU build ID of the pax.so this table was built against, in hex. */
+  const char *pax_build_id;
+
+  /* List the micro-partitions of 'rel' visible to 'snapshot'.  'qual', the
+   * scan's implicitly ANDed conditions (may be NULL), only serves to skip
+   * micro-partitions and groups whose min/max statistics rule it out, as
+   * PAX's own scan does; the caller still applies it to every row.  'cols'
+   * are the 0-based table columns to read, with their value widths: -1 for
+   * a string (text, varchar, bpchar) or a numeric. */
+  void *(*begin)(struct RelationData *rel, struct SnapshotData *snapshot,
+                 struct List *qual, const int *cols, const int *widths,
+                 int ncols, char *err, size_t errlen);
+  int (*nblocks)(void *scan);
+  void (*info)(void *scan, DatafusionPaxScanInfo *out);
+  /* Decode groups first .. first + count - 1 of block 'index' (all from
+   * 'first' if count < 0; see block_groups) and call 'emit' once per group,
+   * 'account' as the memory held changes; both get 'ctx'.  Returns 0, or -1
+   * with a message (also when 'emit' returns non-zero). */
+  int (*read_block)(void *scan, int index, int first, int count,
+                    DatafusionPaxEmit emit, DatafusionPaxAccount account,
+                    void *ctx, char *err, size_t errlen);
+  void (*end)(void *scan);
+  /* The number of groups of block 'index' left to read once min/max
+   * statistics skipped some, reading the file's footer if needed: callers
+   * may read them in separate read_block calls, on several threads.
+   * Returns -1 with a message on failure.  Any thread, like read_block. */
+  int (*block_groups)(void *scan, int index, char *err, size_t errlen);
+} DatafusionPaxScanApi;
+
+const DatafusionPaxScanApi *datafusion_pax_scan_api(void);
+
+#ifdef __cplusplus
+}
+#endif
