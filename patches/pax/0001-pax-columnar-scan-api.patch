+#include "comm/cbdb_api.h"
+
+#include "access/datafusion_scan_api.h"
+
+#include <algorithm>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "comm/bitmap.h"
+#include "comm/guc.h"
+#include "comm/singleton.h"
+#include "exceptions/CException.h"
+#include "storage/columns/pax_columns.h"
+#include "storage/filter/pax_filter.h"
+#include "storage/filter/pax_sparse_filter.h"
+#include "storage/local_file_system.h"
+#include "storage/micro_partition_file_factory.h"
+#include "storage/micro_partition_iterator.h"
+#include "storage/micro_partition_metadata.h"
+#include "storage/micro_partition_stats.h"
+#include "storage/pax_buffer.h"
+#include "storage/paxc_define.h"
+
+#ifndef DF_PAX_BUILD_ID
+#define DF_PAX_BUILD_ID ""
+#endif
+
+namespace {
+
+struct DfBlock {
+  std::string file;
+  std::string visimap;
+  bool toast;
+  bool all_groups;              // no group was examined: read them all
+  std::vector<uint32_t> groups; // otherwise the groups to read
+};
+
+struct DfScan {
+  std::vector<DfBlock> blocks;
+  int natts;
+  std::vector<int> cols;     // 0-based table columns to hand out
+  std::vector<int> widths;   // their value widths in bytes
+  int read_col;              // column decoded when none is handed out
+  size_t read_buffer_size;   // pax.scan_reuse_buffer_size, in bytes
+  DatafusionPaxScanInfo info;
+};
+
+// A numeric of the vectorized format (comm/vec_numeric.cc), 16 bytes: the
+// value times 10^dscale as a 120-bit two's complement integer, in the low
+// word and bits 0-55 of the high word, dscale in bits 56-61 and a special
+// tag in bits 62-63 (1 +Infinity, 2 NaN, 3 -Infinity).  Appended to 'out'
+// as PostgreSQL's numeric without its varlena header, in the long form:
+// sign and dscale, weight, NBASE digits aligned on the decimal point.
+void AppendVecNumeric(const char *src, std::vector<char> &out) {
+  uint64_t lo, hi;
+  std::memcpy(&lo, src, sizeof(lo));
+  std::memcpy(&hi, src + sizeof(lo), sizeof(hi));
+  auto put16 = [&out](uint16_t v) {
+    const char *b = reinterpret_cast<const char *>(&v);
+    out.insert(out.end(), b, b + sizeof(v));
+  };
+  const unsigned tag = static_cast<unsigned>(hi >> 62);
+  if (tag != 0) {
+    put16(tag == 1 ? 0xD000 : tag == 3 ? 0xF000 : 0xC000);
+    return;
+  }
+  const int dscale = static_cast<int>((hi >> 56) & 0x3F);
+  const unsigned __int128 mask = (static_cast<unsigned __int128>(1) << 120) - 1;
+  unsigned __int128 mag =
+      (static_cast<unsigned __int128>(hi & 0x00FFFFFFFFFFFFFFULL) << 64) | lo;
+  const bool neg = ((hi >> 55) & 1) != 0;
+  if (neg) mag = (~mag + 1) & mask;
+
+  // NBASE digits, least significant first; the lowest fractional one holds
+  // the last dscale % 4 decimal digits, padded with zeros.
+  static const unsigned kPow10[] = {1, 10, 100, 1000, 10000};
+  std::vector<uint16_t> digits;
+  const int partial = dscale % 4;
+  if (partial > 0) {
+    digits.push_back(static_cast<uint16_t>(
+        (mag % kPow10[partial]) * kPow10[4 - partial]));
+    mag /= kPow10[partial];
+  }
+  while (mag > 0) {
+    digits.push_back(static_cast<uint16_t>(mag % 10000));
+    mag /= 10000;
+  }
+  while (!digits.empty() && digits.back() == 0) digits.pop_back();
+  const int nfrac = (dscale + 3) / 4;
+  const int weight = digits.empty() ? 0 : static_cast<int>(digits.size()) - 1 - nfrac;
+  put16(static_cast<uint16_t>((neg && !digits.empty() ? 0x4000 : 0) | dscale));
+  put16(static_cast<uint16_t>(static_cast<int16_t>(weight)));
+  for (auto d = digits.rbegin(); d != digits.rend(); ++d) put16(*d);
+}
+
+void SetError(char *err, size_t errlen, const char *what, const char *msg) {
+  if (err && errlen > 0) snprintf(err, errlen, "%s: %s", what, msg);
+}
+
+std::unique_ptr<pax::MicroPartitionReader> OpenReader(
+    const DfBlock &block, std::vector<bool> &&proj,
+    std::shared_ptr<pax::DataBuffer<char>> read_buffer) {
+  auto fs = pax::Singleton<pax::LocalFileSystem>::GetInstance();
+  pax::MicroPartitionReader::ReaderOptions options;
+  options.filter = std::make_shared<pax::PaxFilter>();
+  options.filter->SetColumnProjection(std::move(proj));
+  options.reused_buffer = std::move(read_buffer);
+
+  std::unique_ptr<pax::File> toast;
+  if (block.toast)
+    toast = fs->Open(block.file + TOAST_FILE_SUFFIX, pax::fs::kReadMode);
+  return pax::MicroPartitionFileFactory::CreateMicroPartitionReader(
+      options, pax::FLAGS_EMPTY, fs->Open(block.file, pax::fs::kReadMode),
+      std::move(toast));
+}
+
+// Keeps the caller informed of the bytes held, and gives them all back when
+// it goes out of scope, exceptions included.
+class Ledger {
+ public:
+  Ledger(DatafusionPaxAccount account, void *ctx)
+      : account_(account), ctx_(ctx) {}
+  ~Ledger() { Set(0); }
+  void Set(int64_t held) {
+    if (account_ && held != held_) account_(ctx_, held - held_);
+    held_ = held;
+  }
+
+ private:
+  DatafusionPaxAccount account_;
+  void *ctx_;
+  int64_t held_ = 0;
+};
+
+void *ScanBegin(struct RelationData *rel, struct SnapshotData *snapshot,
+                struct List *qual, const int *cols, const int *widths,
+                int ncols, char *err, size_t errlen) {
+  try {
+    auto scan = std::make_unique<DfScan>();
+    scan->natts = RelationGetNumberOfAttributes(rel);
+    scan->cols.assign(cols, cols + ncols);
+    scan->widths.assign(widths, widths + ncols);
+    scan->read_col = ncols > 0 ? cols[0] : 0;
+    scan->read_buffer_size = pax::pax_scan_reuse_buffer_size;
+    scan->info = DatafusionPaxScanInfo{0, 0, 0, 0};
+
+    // The same min/max skipping as PAX's scan: whole micro-partitions by
+    // the statistics in the auxiliary table, then groups by those in the
+    // file footer.  Both evaluate operators through fmgr, which is why it
+    // happens here, on the main thread, and not in read_block.
+    std::shared_ptr<pax::PaxFilter> filter;
+    if (qual != nullptr && pax::pax_enable_sparse_filter) {
+      filter = std::make_shared<pax::PaxFilter>();
+      filter->InitSparseFilter(rel, qual, nullptr, 0);
+      if (!filter->SparseFilterEnabled()) filter.reset();
+    }
+    TupleDesc desc = RelationGetDescr(rel);
+
+    auto it = pax::MicroPartitionIterator::New(rel, snapshot);
+    while (it->HasNext()) {
+      auto meta = it->Next();
+      scan->info.files++;
+      if (filter) {
+        pax::MicroPartitionStatsProvider provider(meta.GetStats());
+        if (!filter->ExecSparseFilter(
+                provider, desc, pax::PaxSparseFilter::StatisticsKind::kFile)) {
+          scan->info.files_skipped++;
+          continue;
+        }
+      }
+      DfBlock block{meta.GetFileName(), meta.GetVisibilityBitmapFile(),
+                    meta.GetExistToast(), true, {}};
+      if (filter) {
+        std::vector<bool> proj(scan->natts, false);
+        proj[scan->read_col] = true;
+        auto reader = OpenReader(block, std::move(proj), nullptr);
+        block.all_groups = false;
+        for (size_t g = 0; g < reader->GetGroupNums(); g++) {
+          scan->info.groups++;
+          auto stats = reader->GetGroupStatsInfo(g);
+          if (filter->ExecSparseFilter(
+                  *stats, desc, pax::PaxSparseFilter::StatisticsKind::kGroup))
+            block.groups.push_back(static_cast<uint32_t>(g));
+          else
+            scan->info.groups_skipped++;
+        }
+        reader->Close();
+        if (block.groups.empty()) continue;
+      }
+      scan->blocks.push_back(std::move(block));
+    }
+    it->Release();
+    return scan.release();
+  } catch (cbdb::CException &e) {
+    SetError(err, errlen, "cannot list PAX micro-partitions", e.What().c_str());
+  } catch (std::exception &e) {
+    SetError(err, errlen, "cannot list PAX micro-partitions", e.what());
+  } catch (...) {
+    SetError(err, errlen, "cannot list PAX micro-partitions", "unknown error");
+  }
+  return nullptr;
+}
+
+int ScanNBlocks(void *scan) {
+  return static_cast<int>(static_cast<DfScan *>(scan)->blocks.size());
+}
+
+void ScanInfo(void *scan, DatafusionPaxScanInfo *out) {
+  *out = static_cast<DfScan *>(scan)->info;
+}
+
+void ScanEnd(void *scan) { delete static_cast<DfScan *>(scan); }
+
+int BlockGroups(void *scan_arg, int index, char *err, size_t errlen) {
+  auto scan = static_cast<DfScan *>(scan_arg);
+  try {
+    const DfBlock &block = scan->blocks.at(index);
+    if (!block.all_groups) return static_cast<int>(block.groups.size());
+    // Only the footer is read: no group of the read column is decoded.
+    std::vector<bool> proj(scan->natts, false);
+    proj[scan->read_col] = true;
+    auto reader = OpenReader(block, std::move(proj), nullptr);
+    const int n = static_cast<int>(reader->GetGroupNums());
+    reader->Close();
+    return n;
+  } catch (cbdb::CException &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.What().c_str());
+  } catch (std::exception &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.what());
+  } catch (...) {
+    SetError(err, errlen, "cannot read PAX micro-partition", "unknown error");
+  }
+  return -1;
+}
+
+int ReadBlock(void *scan_arg, int index, int first, int count,
+              DatafusionPaxEmit emit, DatafusionPaxAccount account, void *ctx,
+              char *err, size_t errlen) {
+  auto scan = static_cast<DfScan *>(scan_arg);
+  try {
+    // Declared first, so that it is destroyed last: everything it counts is
+    // freed by then.
+    Ledger ledger(account, ctx);
+    const DfBlock &block = scan->blocks.at(index);
+    auto fs = pax::Singleton<pax::LocalFileSystem>::GetInstance();
+
+    std::vector<bool> proj(scan->natts, false);
+    for (int c : scan->cols) proj[c] = true;
+    proj[scan->read_col] = true;
+    std::vector<int> projected;
+    for (int c = 0; c < scan->natts; c++)
+      if (proj[c]) projected.push_back(c);
+
+    int64_t visimap_bytes = 0;
+    std::shared_ptr<pax::Bitmap8> visimap;
+    if (!block.visimap.empty()) {
+      auto file = fs->Open(block.visimap, pax::fs::kReadMode);
+      auto len = file->FileLength();
+      visimap = std::make_shared<pax::Bitmap8>(len * 8);
+      file->ReadN(visimap->Raw().bitmap, len);
+      file->Close();
+      visimap_bytes = static_cast<int64_t>(len);
+    }
+
+    auto read_buffer =
+        std::make_shared<pax::DataBuffer<char>>(scan->read_buffer_size);
+    auto reader = OpenReader(block, std::move(proj), read_buffer);
+
+    const size_t ncols = scan->cols.size();
+    std::vector<std::vector<char>> values(ncols);
+    std::vector<std::vector<uint8_t>> nulls(ncols);
+    std::vector<std::vector<int32_t>> offsets(ncols);
+    std::vector<DatafusionPaxColumn> out(ncols);
+    std::vector<size_t> nonnull(ncols);
+
+    // The block's groups to read are numbered 0 .. ngroups - 1; this call
+    // reads 'count' of them from 'first' (all from there if count < 0).
+    const size_t ngroups =
+        block.all_groups ? reader->GetGroupNums() : block.groups.size();
+    const size_t from = std::min(static_cast<size_t>(std::max(first, 0)), ngroups);
+    const size_t to =
+        count < 0 ? ngroups : std::min(from + static_cast<size_t>(count), ngroups);
+    for (size_t n = from; n < to; n++) {
+      const size_t g = block.all_groups ? n : block.groups[n];
+      auto group = reader->ReadGroup(g);
+      auto &columns = *group->GetAllColumns();
+      const size_t rows = group->GetRows();
+      const size_t offset = group->GetRowOffset();
+
+      int64_t decoded = 0;
+      for (int c : projected) {
+        pax::PaxColumn *col = columns[c].get();
+        if (col == nullptr) continue;
+        decoded += static_cast<int64_t>(col->GetBuffer().second);
+        if (col->GetBitmap())
+          decoded += static_cast<int64_t>(col->GetBitmap()->Raw().size);
+      }
+      const int64_t base = visimap_bytes +
+                           static_cast<int64_t>(read_buffer->Capacity()) +
+                           decoded;
+      ledger.Set(base);
+
+      // Rows deleted in the visibility map are left out.
+      std::vector<uint32_t> keep;
+      keep.reserve(rows);
+      for (size_t r = 0; r < rows; r++)
+        if (!visimap || !visimap->Test(static_cast<uint32>(offset + r)))
+          keep.push_back(static_cast<uint32_t>(r));
+
+      struct ColState {
+        pax::PaxColumn *col;
+        const char *buf;
+        pax::Bitmap8 *bm;  // bit set: the row has a value
+        bool dense;
+        bool bits;
+        bool vec_numeric;
+      };
+      std::vector<ColState> cols(ncols);
+      for (size_t k = 0; k < ncols; k++) {
+        pax::PaxColumn *col = columns[scan->cols[k]].get();
+        if (col == nullptr) {
+          SetError(err, errlen, "PAX read", "projected column missing");
+          return -1;
+        }
+        // In the plain format only non-null values are stored, in row
+        // order; in the vectorized format every row has a slot.  That
+        // format keeps booleans bit-packed in memory, one bit per row,
+        // least significant bit first; the plain format has already
+        // decoded them to one byte per value.
+        cols[k] = ColState{
+            col, col->GetBuffer().first, col->GetBitmap().get(),
+            col->GetStorageFormat() !=
+                pax::PaxStorageFormat::kTypeStoragePorcVec,
+            col->GetPaxColumnTypeInMem() ==
+                pax::PaxColumnTypeInMem::kTypeVecBitPacked,
+            col->GetPaxColumnTypeInMem() ==
+                pax::PaxColumnTypeInMem::kTypeVecDecimal};
+        const int w = scan->widths[k];
+        values[k].assign(w > 0 ? keep.size() * w : 0, 0);
+        nulls[k].assign(keep.size(), 0);
+        offsets[k].assign(w > 0 ? 0 : 1, 0);
+        nonnull[k] = 0;
+      }
+
+      // Rows go out in chunks of kChunkRows, so that the caller can start
+      // on them while the rest of the group is converted, and whose string
+      // bytes stay below kChunkBytes, so that their int32 offsets cannot
+      // overflow (a value has at most 1 GB).
+      constexpr size_t kChunkRows = 8192;
+      constexpr size_t kChunkBytes = 64 << 20;
+      size_t chunk = 0, chunk_bytes = 0;
+      auto flush = [&]() -> bool {
+        int64_t handed_out = static_cast<int64_t>(keep.capacity() * 4);
+        for (size_t k = 0; k < ncols; k++) {
+          handed_out += static_cast<int64_t>(values[k].capacity() +
+                                             nulls[k].capacity() +
+                                             offsets[k].capacity() * 4);
+          // never NULL, even for a chunk of empty strings
+          static const char kNoBytes = 0;
+          out[k].values = values[k].empty() ? &kNoBytes : values[k].data();
+          out[k].nulls = nulls[k].data();
+          out[k].offsets = scan->widths[k] > 0 ? nullptr : offsets[k].data();
+        }
+        ledger.Set(base + handed_out);
+        if (emit(ctx, static_cast<uint32_t>(chunk), out.data()) != 0) {
+          SetError(err, errlen, "PAX read", "the consumer stopped");
+          return false;
+        }
+        for (size_t k = 0; k < ncols; k++)
+          if (scan->widths[k] <= 0) {
+            values[k].clear();
+            offsets[k].assign(1, 0);
+          }
+        chunk = 0;
+        chunk_bytes = 0;
+        return true;
+      };
+
+      size_t next = 0;
+      for (size_t r = 0; r < rows && next < keep.size(); r++) {
+        const bool kept = keep[next] == r;
+        for (size_t k = 0; k < ncols; k++) {
+          const ColState &st = cols[k];
+          const bool present = !st.bm || st.bm->Test(static_cast<uint32>(r));
+          if (kept) {
+            const int w = scan->widths[k];
+            const size_t i = st.dense ? nonnull[k] : r;
+            if (!present) {
+              nulls[k][chunk] = 1;
+              if (w > 0)
+                std::memset(values[k].data() + chunk * w, 0, w);
+              else
+                offsets[k].push_back(static_cast<int32_t>(values[k].size()));
+            } else if (w <= 0 && st.vec_numeric) {
+              // the vectorized format's numeric, decoded here: its own
+              // GetDatum goes through PostgreSQL's numeric functions
+              nulls[k][chunk] = 0;
+              AppendVecNumeric(st.buf + i * 16, values[k]);
+              offsets[k].push_back(static_cast<int32_t>(values[k].size()));
+            } else if (w <= 0) {
+              // A string or a numeric: its bytes without the varlena header.  GetDatum
+              // decodes PAX's toast (compressed inline or in the toast
+              // file, with PAX's own pglz/lz4) and, in the vectorized
+              // format, restores the header and char(n)'s padding.
+              nulls[k][chunk] = 0;
+              const struct varlena *v = reinterpret_cast<const struct varlena *>(
+                  DatumGetPointer(st.col->GetDatum(i)));
+              if (VARATT_IS_EXTERNAL(v) || VARATT_IS_COMPRESSED(v)) {
+                SetError(err, errlen, "PAX read", "toasted value left");
+                return -1;
+              }
+              const size_t len = VARSIZE_ANY_EXHDR(v);
+              values[k].insert(values[k].end(), VARDATA_ANY(v),
+                               VARDATA_ANY(v) + len);
+              offsets[k].push_back(static_cast<int32_t>(values[k].size()));
+              chunk_bytes += len;
+            } else {
+              nulls[k][chunk] = 0;
+              if (st.bits)
+                values[k][chunk] =
+                    (static_cast<unsigned char>(st.buf[i >> 3]) >> (i & 7)) & 1;
+              else
+                std::memcpy(values[k].data() + chunk * w, st.buf + i * w, w);
+            }
+          }
+          if (present) nonnull[k]++;
+        }
+        if (kept) {
+          next++;
+          chunk++;
+          if ((chunk >= kChunkRows || chunk_bytes >= kChunkBytes) && !flush())
+            return -1;
+        }
+      }
+      if (chunk > 0 && !flush()) return -1;
+    }
+    reader->Close();
+    return 0;
+  } catch (cbdb::CException &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.What().c_str());
+  } catch (std::exception &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.what());
+  } catch (...) {
+    SetError(err, errlen, "cannot read PAX micro-partition", "unknown error");
+  }
+  return -1;
+}
+
+const DatafusionPaxScanApi kScanApi = {
+    DATAFUSION_PAX_SCAN_API_VERSION,
+    DF_PAX_BUILD_ID,
+    ScanBegin,
+    ScanNBlocks,
+    ScanInfo,
+    ReadBlock,
+    ScanEnd,
+    BlockGroups,
+};
+
+}  // namespace
+
+extern "C" __attribute__((visibility("default"))) const DatafusionPaxScanApi *
+datafusion_pax_scan_api(void) {
+  return &kScanApi;
+}
