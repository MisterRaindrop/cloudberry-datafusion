+struct DfBlock {
+  std::string file;
+  std::string visimap;
+  bool toast;
+  bool all_groups;              // no group was examined: read them all
+  std::vector<uint32_t> groups; // otherwise the groups to read
+};
+
+struct DfScan {
+  std::vector<DfBlock> blocks;
+  int natts;
+  std::vector<int> cols;     // 0-based table columns to hand out
+  std::vector<int> widths;   // their value widths in bytes
+  std::vector<int> scales;   // a numeric's scale when read fixed-width, or -1
+  int read_col;              // column decoded when none is handed out
+  std::vector<bool> late;    // per handed-out column: left to read_rows
+  size_t read_buffer_size;   // pax.scan_reuse_buffer_size, in bytes
+  DatafusionPaxScanInfo info;
+};
+
+// A numeric of the vectorized format (comm/vec_numeric.cc), 16 bytes: the
+// value times 10^dscale as a 120-bit two's complement integer, in the low
+// word and bits 0-55 of the high word, dscale in bits 56-61 and a special
+// tag in bits 62-63 (1 +Infinity, 2 NaN, 3 -Infinity).  Appended to 'out'
+// as PostgreSQL's numeric without its varlena header, in the long form:
+// sign and dscale, weight, NBASE digits aligned on the decimal point.
+void AppendVecNumeric(const char *src, std::vector<char> &out) {
+  uint64_t lo, hi;
+  std::memcpy(&lo, src, sizeof(lo));
+  std::memcpy(&hi, src + sizeof(lo), sizeof(hi));
+  auto put16 = [&out](uint16_t v) {
+    const char *b = reinterpret_cast<const char *>(&v);
+    out.insert(out.end(), b, b + sizeof(v));
+  };
+  const unsigned tag = static_cast<unsigned>(hi >> 62);
+  if (tag != 0) {
+    put16(tag == 1 ? 0xD000 : tag == 3 ? 0xF000 : 0xC000);
+    return;
+  }
+  const int dscale = static_cast<int>((hi >> 56) & 0x3F);
+  const unsigned __int128 mask = (static_cast<unsigned __int128>(1) << 120) - 1;
+  unsigned __int128 mag =
+      (static_cast<unsigned __int128>(hi & 0x00FFFFFFFFFFFFFFULL) << 64) | lo;
+  const bool neg = ((hi >> 55) & 1) != 0;
+  if (neg) mag = (~mag + 1) & mask;
+
+  // NBASE digits, least significant first; the lowest fractional one holds
+  // the last dscale % 4 decimal digits, padded with zeros.
+  static const unsigned kPow10[] = {1, 10, 100, 1000, 10000};
+  std::vector<uint16_t> digits;
+  const int partial = dscale % 4;
+  if (partial > 0) {
+    digits.push_back(static_cast<uint16_t>(
+        (mag % kPow10[partial]) * kPow10[4 - partial]));
+    mag /= kPow10[partial];
+  }
+  while (mag > 0) {
+    digits.push_back(static_cast<uint16_t>(mag % 10000));
+    mag /= 10000;
+  }
+  while (!digits.empty() && digits.back() == 0) digits.pop_back();
+  const int nfrac = (dscale + 3) / 4;
+  const int weight = digits.empty() ? 0 : static_cast<int>(digits.size()) - 1 - nfrac;
+  put16(static_cast<uint16_t>((neg && !digits.empty() ? 0x4000 : 0) | dscale));
+  put16(static_cast<uint16_t>(static_cast<int16_t>(weight)));
+  for (auto d = digits.rbegin(); d != digits.rend(); ++d) put16(*d);
+}
+
+// Numerics read at a scale (DatafusionPaxScanApi.begin): 16 or 32
+// little-endian bytes (the column's width), the value times 10^scale,
+// sign-extended from 128 bits; NaN and the infinities as DataFusion's
+// numeric marks them (pgnum.rs): the largest integer, one less, the least.
+const __int128 kPow10I128[] = {
+    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000,
+    1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000,
+    100000000000000, 1000000000000000, 10000000000000000,
+    100000000000000000, 1000000000000000000,
+    static_cast<__int128>(1000000000000000000) * 10,
+    static_cast<__int128>(1000000000000000000) * 100,
+    static_cast<__int128>(1000000000000000000) * 1000,
+    static_cast<__int128>(1000000000000000000) * 10000,
+    static_cast<__int128>(1000000000000000000) * 100000,
+    static_cast<__int128>(1000000000000000000) * 1000000,
+    static_cast<__int128>(1000000000000000000) * 10000000,
+    static_cast<__int128>(1000000000000000000) * 100000000,
+    static_cast<__int128>(1000000000000000000) * 1000000000,
+    static_cast<__int128>(1000000000000000000) * 10000000000,
+    static_cast<__int128>(1000000000000000000) * 100000000000,
+    static_cast<__int128>(1000000000000000000) * 1000000000000,
+    static_cast<__int128>(1000000000000000000) * 10000000000000,
+    static_cast<__int128>(1000000000000000000) * 100000000000000,
+    static_cast<__int128>(1000000000000000000) * 1000000000000000,
+    static_cast<__int128>(1000000000000000000) * 10000000000000000,
+    static_cast<__int128>(1000000000000000000) * 100000000000000000,
+    static_cast<__int128>(1000000000000000000) * 1000000000000000000,
+    static_cast<__int128>(1000000000000000000) * 1000000000000000000 * 10,
+    static_cast<__int128>(1000000000000000000) * 1000000000000000000 * 100,
+};
+constexpr int kFixedDigits = 38;
+const uint32_t kPow10U32[] = {1, 10, 100, 1000, 10000};
+
+// The value whose 64-bit halves are lo and hi, as w bytes: two 8-byte
+// stores.  A 16-byte value built in memory by two 8-byte stores and read
+// back at once waits for them (no store forwarding), about a third of
+// TPC-H Q1's conversions.
+void StoreHalves(uint64_t lo, uint64_t hi, char *out, int w) {
+  std::memcpy(out, &lo, sizeof(lo));
+  std::memcpy(out + sizeof(lo), &hi, sizeof(hi));
+  if (w > 16) std::memset(out + 16, static_cast<int64_t>(hi) < 0 ? 0xFF : 0, 16);
+}
+
+void StoreFixed(__int128 v, char *out, int w) {
+  StoreHalves(static_cast<uint64_t>(v),
+              static_cast<uint64_t>(static_cast<unsigned __int128>(v) >> 64), out, w);
+}
+
+// d / 10^k for k of 1 to 3, by constants: a multiply, not a division.
+inline uint32_t DivPow10(uint32_t d, int k) {
+  return k == 1 ? d / 10 : k == 2 ? d / 100 : d / 1000;
+}
+
+// tag: 1 +Infinity, 2 NaN, 3 -Infinity
+void StoreSpecial(unsigned tag, char *out, int w) {
+  std::memset(out, tag == 3 ? 0 : 0xFF, w);
+  if (tag == 1) out[0] = static_cast<char>(0xFE);
+  out[w - 1] = static_cast<char>(tag == 3 ? 0x80 : 0x7F);
+}
+
+// PostgreSQL's numeric 'p' of 'len' bytes (no varlena header) at 'scale'.
+// False when it has more decimal places than 'scale' or more than 38
+// digits at it.
+bool PgNumericToFixed(const char *p, size_t len, int scale, char *out, int w) {
+  if (len < 2) return false;
+  uint16_t h;
+  std::memcpy(&h, p, 2);
+  int dscale, weight;
+  bool neg;
+  size_t first;
+  if ((h & 0xC000) == 0xC000) {
+    StoreSpecial(h == 0xC000 ? 2 : h == 0xF000 ? 3 : 1, out, w);
+    return true;
+  }
+  if (h & 0x8000) {  // short form
+    neg = (h & 0x2000) != 0;
+    dscale = (h & 0x1F80) >> 7;
+    weight = (h & 0x003F) - ((h & 0x0040) ? 0x40 : 0);
+    first = 2;
+  } else {
+    if (len < 4) return false;
+    int16_t w;
+    std::memcpy(&w, p + 2, 2);
+    neg = (h & 0xC000) == 0x4000;
+    dscale = h & 0x3FFF;
+    weight = w;
+    first = 4;
+  }
+  const size_t ndigits = (len - first) / 2;
+  if (dscale > scale) return false;
+  if (ndigits == 0) {
+    StoreFixed(0, out, w);
+    return true;
+  }
+  uint16_t d0;
+  std::memcpy(&d0, p + first, 2);
+  const int lead = d0 >= 1000 ? 4 : d0 >= 100 ? 3 : d0 >= 10 ? 2 : 1;
+  if (weight >= 0 && 4 * weight + lead + scale > kFixedDigits) return false;
+  // Horner: after digit i, acc is the value so far over 10^e, e the power
+  // of ten of that digit's last place at 'scale'.  A digit whose places
+  // reach past 'scale' has zeros there (dscale <= scale) and is the last.
+  // The first four digits (16 decimal ones) in 64 bits: a 128-bit multiply
+  // per digit was most of a conversion, and few values have more.
+  uint64_t acc64 = 0;
+  int e = 0;
+  size_t i = 0;
+  bool last = false;
+  for (; i < ndigits && i < 4; i++) {
+    uint16_t d;
+    std::memcpy(&d, p + first + 2 * i, 2);
+    const int de = 4 * (weight - static_cast<int>(i)) + scale;
+    if (de >= 0) {
+      acc64 = acc64 * 10000 + d;
+      e = de;
+    } else {
+      // 32-bit: a 128-bit division would be a libgcc call per value
+      if (de > -4) acc64 = acc64 * kPow10U32[4 + de] + DivPow10(d, -de);
+      e = 0;
+      last = true;
+      break;
+    }
+  }
+  __int128 acc = static_cast<__int128>(acc64);
+  for (; !last && i < ndigits; i++) {
+    uint16_t d;
+    std::memcpy(&d, p + first + 2 * i, 2);
+    const int de = 4 * (weight - static_cast<int>(i)) + scale;
+    if (de >= 0) {
+      acc = acc * 10000 + d;
+      e = de;
+    } else {
+      if (de > -4) acc = acc * kPow10U32[4 + de] + DivPow10(d, -de);
+      e = 0;
+      break;
+    }
+  }
+  // within 18 digits the scaling stays in 64 bits too, and so does the
+  // sign: the halves of -r are 0 - r and all ones (unless r is 0)
+  if (acc < static_cast<__int128>(1000000000000000000LL) && e <= 18 &&
+      static_cast<uint64_t>(acc) <= UINT64_MAX / static_cast<uint64_t>(kPow10I128[e])) {
+    const uint64_t r = static_cast<uint64_t>(acc) * static_cast<uint64_t>(kPow10I128[e]);
+    StoreHalves(neg ? 0 - r : r, neg && r != 0 ? ~uint64_t{0} : 0, out, w);
+    return true;
+  }
+  acc *= kPow10I128[e];
+  StoreFixed(neg ? -acc : acc, out, w);
+  return true;
+}
+
+// The vectorized format's numeric (see AppendVecNumeric) at 'scale'.
+bool VecNumericToFixed(const char *src, int scale, char *out, int w) {
+  uint64_t lo, hi;
+  std::memcpy(&lo, src, sizeof(lo));
+  std::memcpy(&hi, src + sizeof(lo), sizeof(hi));
+  const unsigned tag = static_cast<unsigned>(hi >> 62);
+  if (tag != 0) {
+    StoreSpecial(tag, out, w);
+    return true;
+  }
+  const int dscale = static_cast<int>((hi >> 56) & 0x3F);
+  if (dscale > scale || scale - dscale > kFixedDigits) return false;
+  // 120-bit two's complement: sign-extend from bit 119
+  unsigned __int128 u =
+      (static_cast<unsigned __int128>(hi & 0x00FFFFFFFFFFFFFFULL) << 64) | lo;
+  if ((hi >> 55) & 1) u |= ~((static_cast<unsigned __int128>(1) << 120) - 1);
+  const __int128 v = static_cast<__int128>(u);
+  const __int128 m = kPow10I128[scale - dscale];
+  const __int128 limit = kPow10I128[kFixedDigits - (scale - dscale)];
+  if (v >= limit || v <= -limit) return false;
+  StoreFixed(v * m, out, w);
+  return true;
+}
+
+void SetError(char *err, size_t errlen, const char *what, const char *msg) {
+  if (err && errlen > 0) snprintf(err, errlen, "%s: %s", what, msg);
+}
+
+std::unique_ptr<pax::MicroPartitionReader> OpenReader(
+    const DfBlock &block, std::vector<bool> &&proj,
+    std::shared_ptr<pax::DataBuffer<char>> read_buffer) {
+  auto fs = pax::Singleton<pax::LocalFileSystem>::GetInstance();
+  pax::MicroPartitionReader::ReaderOptions options;
+  options.filter = std::make_shared<pax::PaxFilter>();
+  options.filter->SetColumnProjection(std::move(proj));
+  options.reused_buffer = std::move(read_buffer);
+
+  std::unique_ptr<pax::File> toast;
+  if (block.toast)
+    toast = fs->Open(block.file + TOAST_FILE_SUFFIX, pax::fs::kReadMode);
+  return pax::MicroPartitionFileFactory::CreateMicroPartitionReader(
+      options, pax::FLAGS_EMPTY, fs->Open(block.file, pax::fs::kReadMode),
+      std::move(toast));
+}
+
+// Keeps the caller informed of the bytes held, and gives them all back when
+// it goes out of scope, exceptions included.
+class Ledger {
+ public:
+  Ledger(DatafusionPaxAccount account, void *ctx)
+      : account_(account), ctx_(ctx) {}
+  ~Ledger() { Set(0); }
+  void Set(int64_t held) {
+    if (account_ && held != held_) account_(ctx_, held - held_);
+    held_ = held;
+  }
+
+ private:
+  DatafusionPaxAccount account_;
+  void *ctx_;
+  int64_t held_ = 0;
+};
+
+void *ScanBegin(struct RelationData *rel, struct SnapshotData *snapshot,
+                struct List *qual, const int *cols, const int *widths,
+                const int *scales, int ncols, char *err, size_t errlen) {
+  try {
+    auto scan = std::make_unique<DfScan>();
+    scan->natts = RelationGetNumberOfAttributes(rel);
+    scan->cols.assign(cols, cols + ncols);
+    scan->widths.assign(widths, widths + ncols);
+    scan->scales.assign(scales, scales + ncols);
+    scan->read_col = ncols > 0 ? cols[0] : 0;
+    scan->late.assign(ncols, false);
+    scan->read_buffer_size = pax::pax_scan_reuse_buffer_size;
+    scan->info = DatafusionPaxScanInfo{0, 0, 0, 0};
+
+    // The same min/max skipping as PAX's scan: whole micro-partitions by
+    // the statistics in the auxiliary table, then groups by those in the
+    // file footer.  Both evaluate operators through fmgr, which is why it
+    // happens here, on the main thread, and not in read_block.
+    std::shared_ptr<pax::PaxFilter> filter;
+    if (qual != nullptr && pax::pax_enable_sparse_filter) {
+      filter = std::make_shared<pax::PaxFilter>();
+      filter->InitSparseFilter(rel, qual, nullptr, 0);
+      if (!filter->SparseFilterEnabled()) filter.reset();
+    }
+    TupleDesc desc = RelationGetDescr(rel);
+
+    auto it = pax::MicroPartitionIterator::New(rel, snapshot);
+    while (it->HasNext()) {
+      auto meta = it->Next();
+      scan->info.files++;
+      if (filter) {
+        pax::MicroPartitionStatsProvider provider(meta.GetStats());
+        if (!filter->ExecSparseFilter(
+                provider, desc, pax::PaxSparseFilter::StatisticsKind::kFile)) {
+          scan->info.files_skipped++;
+          continue;
+        }
+      }
+      DfBlock block{meta.GetFileName(), meta.GetVisibilityBitmapFile(),
+                    meta.GetExistToast(), true, {}};
+      if (filter) {
+        std::vector<bool> proj(scan->natts, false);
+        proj[scan->read_col] = true;
+        auto reader = OpenReader(block, std::move(proj), nullptr);
+        block.all_groups = false;
+        for (size_t g = 0; g < reader->GetGroupNums(); g++) {
+          scan->info.groups++;
+          auto stats = reader->GetGroupStatsInfo(g);
+          if (filter->ExecSparseFilter(
+                  *stats, desc, pax::PaxSparseFilter::StatisticsKind::kGroup))
+            block.groups.push_back(static_cast<uint32_t>(g));
+          else
+            scan->info.groups_skipped++;
+        }
+        reader->Close();
+        if (block.groups.empty()) continue;
+      }
+      scan->blocks.push_back(std::move(block));
+    }
+    it->Release();
+    return scan.release();
+  } catch (cbdb::CException &e) {
+    SetError(err, errlen, "cannot list PAX micro-partitions", e.What().c_str());
+  } catch (std::exception &e) {
+    SetError(err, errlen, "cannot list PAX micro-partitions", e.what());
+  } catch (...) {
+    SetError(err, errlen, "cannot list PAX micro-partitions", "unknown error");
+  }
+  return nullptr;
+}
+
+int ScanNBlocks(void *scan) {
+  return static_cast<int>(static_cast<DfScan *>(scan)->blocks.size());
+}
+
+void ScanInfo(void *scan, DatafusionPaxScanInfo *out) {
+  *out = static_cast<DfScan *>(scan)->info;
+}
+
+void ScanEnd(void *scan) { delete static_cast<DfScan *>(scan); }
+
+int BlockGroups(void *scan_arg, int index, char *err, size_t errlen) {
+  auto scan = static_cast<DfScan *>(scan_arg);
+  try {
+    const DfBlock &block = scan->blocks.at(index);
+    if (!block.all_groups) return static_cast<int>(block.groups.size());
+    // Only the footer is read: no group of the read column is decoded.
+    std::vector<bool> proj(scan->natts, false);
+    proj[scan->read_col] = true;
+    auto reader = OpenReader(block, std::move(proj), nullptr);
+    const int n = static_cast<int>(reader->GetGroupNums());
+    reader->Close();
+    return n;
+  } catch (cbdb::CException &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.What().c_str());
+  } catch (std::exception &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.what());
+  } catch (...) {
+    SetError(err, errlen, "cannot read PAX micro-partition", "unknown error");
+  }
+  return -1;
+}
+
+// A projected column of the group being read.
+struct ColState {
+  bool active;  // decoded by this read: the others are not handed out
+  pax::PaxColumn *col;
+  const char *buf;
+  pax::Bitmap8 *bm;  // bit set: the row has a value
+  bool dense;
+  bool bits;
+  bool vec_numeric;
+  int width;
+  int scale;
+  // dense columns with nulls: the value index of each row
+  std::vector<uint32_t> index;
+};
+
+// The chunk 'emit' is handed: rows j0 .. j1 - 1 of the group's kept rows
+// ('keep' lists them unless all are).  Its fixed-width columns are
+// converted when the consumer fetches them, for the rows it asks for: those
+// the conditions it checks first leave (FetchColumn).
+struct Chunk {
+  std::vector<ColState> *cols;
+  std::vector<std::vector<char>> *values;
+  std::vector<std::vector<uint8_t>> *nulls;
+  const std::vector<uint32_t> *keep;
+  bool all_kept;
+  size_t j0, j1;
+  // what the rows' locators name, and room for them
+  int block;
+  uint32_t group;
+  std::vector<int64_t> *locs;
+  std::vector<uint8_t> *loc_nulls;
+  // the first failure, for read_block's message
+  char *err;
+  size_t errlen;
+  bool failed;
+};
+
+// Converts row r (value i) of fixed-width column 'st' into dst/nl.
+bool ConvertFixed(const ColState &st, size_t r, size_t i, char *dst, uint8_t *nl,
+                  char *err, size_t errlen) {
+  const int w = st.width;
+  if (st.bm && !st.bm->Test(static_cast<uint32>(r))) {
+    *nl = 1;
+    std::memset(dst, 0, w);
+    return true;
+  }
+  *nl = 0;
+  if (st.scale >= 0) {
+    // a numeric read at a scale
+    bool ok;
+    if (st.vec_numeric) {
+      ok = VecNumericToFixed(st.buf + i * 16, st.scale, dst, w);
+    } else {
+      const struct varlena *v = reinterpret_cast<const struct varlena *>(
+          DatumGetPointer(st.col->GetDatum(i)));
+      if (VARATT_IS_EXTERNAL(v) || VARATT_IS_COMPRESSED(v)) {
+        SetError(err, errlen, "PAX read", "toasted value left");
+        return false;
+      }
+      ok = PgNumericToFixed(VARDATA_ANY(v), VARSIZE_ANY_EXHDR(v), st.scale, dst, w);
+    }
+    if (!ok) {
+      char msg[96];
+      snprintf(msg, sizeof(msg), "numeric value beyond numeric(%d, %d)",
+               kFixedDigits, st.scale);
+      SetError(err, errlen, "PAX read", msg);
+    }
+    return ok;
+  }
+  if (st.bits)
+    *dst = (static_cast<unsigned char>(st.buf[i >> 3]) >> (i & 7)) & 1;
+  else
+    std::memcpy(dst, st.buf + i * w, w);
+  return true;
+}
+
+// DatafusionPaxFetch: fixed-width column k of the chunk, of the chunk rows
+// 'rows' (all if NULL).
+int FetchColumn(void *chunk_arg, int k, const uint32_t *rows, uint32_t nrows,
+                DatafusionPaxColumn *out) {
+  auto ch = static_cast<Chunk *>(chunk_arg);
+  try {
+    if (k == DATAFUSION_PAX_LOCATOR) {
+      const size_t n = rows ? nrows : ch->j1 - ch->j0;
+      ch->locs->resize(std::max<size_t>(n, 1));
+      ch->loc_nulls->assign(std::max<size_t>(n, 1), 0);
+      for (size_t t = 0; t < n; t++) {
+        const size_t j = ch->j0 + (rows ? rows[t] : t);
+        const size_t r = ch->all_kept ? j : (*ch->keep)[j];
+        (*ch->locs)[t] = (static_cast<int64_t>(ch->block) << 40) |
+                         (static_cast<int64_t>(ch->group) << 24) |
+                         static_cast<int64_t>(r);
+      }
+      out->values = ch->locs->data();
+      out->nulls = ch->loc_nulls->data();
+      out->offsets = nullptr;
+      return 0;
+    }
+    if (k < 0 || static_cast<size_t>(k) >= ch->cols->size() ||
+        !(*ch->cols)[k].active || (*ch->cols)[k].width <= 0) {
+      SetError(ch->err, ch->errlen, "PAX read", "fetch of a column not fetched so");
+      ch->failed = true;
+      return -1;
+    }
+    const ColState &st = (*ch->cols)[k];
+    const int w = st.width;
+    const size_t n = rows ? nrows : ch->j1 - ch->j0;
+    auto &nulls = (*ch->nulls)[k];
+    auto &values = (*ch->values)[k];
+    // A column without nulls of a group without deleted rows: the stored
+    // values themselves when all rows are wanted.
+    if (!st.bm && ch->all_kept && !st.bits && st.scale < 0) {
+      nulls.assign(std::max<size_t>(n, 1), 0);
+      out->nulls = nulls.data();
+      out->offsets = nullptr;
+      if (!rows) {
+        out->values = st.buf + ch->j0 * w;
+        return 0;
+      }
+      values.resize(std::max<size_t>(n, 1) * w);
+      char *dst = values.data();
+      const char *src = st.buf + ch->j0 * w;
+      switch (w) {
+        case 4:
+          for (size_t t = 0; t < n; t++) std::memcpy(dst + 4 * t, src + 4 * rows[t], 4);
+          break;
+        case 8:
+          for (size_t t = 0; t < n; t++) std::memcpy(dst + 8 * t, src + 8 * rows[t], 8);
+          break;
+        default:
+          for (size_t t = 0; t < n; t++)
+            std::memcpy(dst + w * t, src + static_cast<size_t>(w) * rows[t], w);
+      }
+      out->values = dst;
+      return 0;
+    }
+    nulls.resize(std::max<size_t>(n, 1));
+    values.resize(std::max<size_t>(n, 1) * w);
+    char *dst = values.data();
+    uint8_t *nl = nulls.data();
+    for (size_t t = 0; t < n; t++) {
+      const size_t j = ch->j0 + (rows ? rows[t] : t);
+      const size_t r = ch->all_kept ? j : (*ch->keep)[j];
+      const size_t i = !st.dense ? r : st.bm ? st.index[r] : r;
+      if (!ConvertFixed(st, r, i, dst + t * w, nl + t, ch->err, ch->errlen)) {
+        ch->failed = true;
+        return -1;
+      }
+    }
+    out->values = dst;
+    out->nulls = nl;
+    out->offsets = nullptr;
+    return 0;
+  } catch (cbdb::CException &e) {
+    SetError(ch->err, ch->errlen, "cannot read PAX micro-partition", e.What().c_str());
+  } catch (std::exception &e) {
+    SetError(ch->err, ch->errlen, "cannot read PAX micro-partition", e.what());
+  } catch (...) {
+    SetError(ch->err, ch->errlen, "cannot read PAX micro-partition", "unknown error");
+  }
+  ch->failed = true;
+  return -1;
+}
+
+// Hands out rows of one decoded group, of 'nrows' rows: those 'keep' lists
+// (positions in the group) unless 'all_kept', in chunks.  'colv' holds the
+// group's column of each handed-out column, null for one this read does
+// not decode.  'base' is what the reader holds besides the chunks.
+int EmitGroup(const DfScan *scan, int index, uint32_t g,
+              const std::vector<pax::PaxColumn *> &colv, size_t rows,
+              const std::vector<uint32_t> &keep, bool all_kept, Ledger &ledger,
+              int64_t base, DatafusionPaxEmit emit, void *ctx, char *err,
+              size_t errlen) {
+  const size_t ncols = scan->cols.size();
+  std::vector<std::vector<char>> values(ncols);
+  std::vector<std::vector<uint8_t>> nulls(ncols);
+  std::vector<std::vector<int32_t>> offsets(ncols);
+  std::vector<DatafusionPaxColumn> out(ncols);
+  std::vector<int64_t> locs;
+  std::vector<uint8_t> loc_nulls;
+
+  // Rows go out in chunks of kChunkRows, so that the caller can start on
+  // them while the rest of the group is converted, and whose string bytes
+  // stay below kChunkBytes, so that their int32 offsets cannot overflow (a
+  // value has at most 1 GB).  kChunkRows is DataFusion's batch size: a
+  // chunk's columns stay in cache while its batch goes through the plan.
+  constexpr size_t kChunkRows = 4096;
+  constexpr size_t kChunkBytes = 64 << 20;
+
+  const size_t nkept = all_kept ? rows : keep.size();
+  auto row_of = [&](size_t j) -> size_t { return all_kept ? j : keep[j]; };
+
+  std::vector<ColState> cols(ncols);
+  for (size_t k = 0; k < ncols; k++) {
+    ColState &st = cols[k];
+    pax::PaxColumn *col = colv[k];
+    st.active = col != nullptr;
+    st.width = scan->widths[k];
+    st.scale = scan->scales[k];
+    if (!st.active) continue;
+    // In the plain format only non-null values are stored, in row
+    // order; in the vectorized format every row has a slot.  That
+    // format keeps booleans bit-packed in memory, one bit per row,
+    // least significant bit first; the plain format has already
+    // decoded them to one byte per value.
+    st.col = col;
+    st.buf = col->GetBuffer().first;
+    st.bm = col->GetBitmap().get();
+    st.dense = col->GetStorageFormat() !=
+               pax::PaxStorageFormat::kTypeStoragePorcVec;
+    st.bits = col->GetPaxColumnTypeInMem() ==
+              pax::PaxColumnTypeInMem::kTypeVecBitPacked;
+    st.vec_numeric = col->GetPaxColumnTypeInMem() ==
+                     pax::PaxColumnTypeInMem::kTypeVecDecimal;
+    if (st.bm && st.dense) {
+      st.index.resize(rows);
+      uint32_t i = 0;
+      for (size_t r = 0; r < rows; r++) {
+        st.index[r] = i;
+        if (st.bm->Test(static_cast<uint32>(r))) i++;
+      }
+    }
+    if (st.width <= 0) {
+      // A chunk's share of the group's stored bytes, as a first guess
+      // that spares growing the chunk's bytes value by value (copies).
+      const size_t per_chunk = std::min(nkept, kChunkRows);
+      offsets[k].reserve(per_chunk + 1);
+      values[k].reserve(col->GetBuffer().second / std::max<size_t>(rows, 1) *
+                        per_chunk * 5 / 4);
+    }
+    nulls[k].resize(std::min(nkept, kChunkRows));
+  }
+
+  // Chunk by chunk: the strings are copied out here, column by column;
+  // the fixed-width columns are converted when the consumer fetches
+  // them (FetchColumn), for the rows it still wants.
+  for (size_t j0 = 0; j0 < nkept;) {
+    size_t j1 = std::min(nkept, j0 + kChunkRows);
+    for (size_t k = 0; k < ncols; k++) {
+      ColState &st = cols[k];
+      if (!st.active || st.width > 0) continue;
+      uint8_t *nl = nulls[k].data();
+      values[k].clear();
+      offsets[k].assign(1, 0);
+      size_t bytes = 0;
+      for (size_t j = j0; j < j1; j++) {
+        const size_t r = row_of(j);
+        const size_t c = j - j0;
+        const bool present = !st.bm || st.bm->Test(static_cast<uint32>(r));
+        const size_t i = !st.dense ? r : st.bm ? st.index[r] : r;
+        if (!present) {
+          nl[c] = 1;
+          offsets[k].push_back(static_cast<int32_t>(values[k].size()));
+          continue;
+        }
+        nl[c] = 0;
+        if (st.vec_numeric) {
+          // the vectorized format's numeric, decoded here: its own
+          // GetDatum goes through PostgreSQL's numeric functions
+          AppendVecNumeric(st.buf + i * 16, values[k]);
+          offsets[k].push_back(static_cast<int32_t>(values[k].size()));
+          continue;
+        }
+        // A string or a numeric: its bytes without the varlena header.
+        // GetDatum decodes PAX's toast (compressed inline or in the toast
+        // file, with PAX's own pglz/lz4) and, in the vectorized format,
+        // restores the header and char(n)'s padding.
+        const struct varlena *v = reinterpret_cast<const struct varlena *>(
+            DatumGetPointer(st.col->GetDatum(i)));
+        if (VARATT_IS_EXTERNAL(v) || VARATT_IS_COMPRESSED(v)) {
+          SetError(err, errlen, "PAX read", "toasted value left");
+          return -1;
+        }
+        const size_t len = VARSIZE_ANY_EXHDR(v);
+        values[k].insert(values[k].end(), VARDATA_ANY(v), VARDATA_ANY(v) + len);
+        offsets[k].push_back(static_cast<int32_t>(values[k].size()));
+        bytes += len;
+        // a chunk of strings past kChunkBytes ends here, for every
+        // column: those done so far are cut back to it
+        if (bytes >= kChunkBytes && j + 1 < j1) {
+          j1 = j + 1;
+          for (size_t q = 0; q < k; q++)
+            if (cols[q].active && cols[q].width <= 0) {
+              offsets[q].resize(j1 - j0 + 1);
+              values[q].resize(static_cast<size_t>(offsets[q].back()));
+            }
+          break;
+        }
+      }
+    }
+
+    auto held = [&]() {
+      int64_t h = static_cast<int64_t>(keep.capacity() * 4 + locs.capacity() * 9);
+      for (size_t k = 0; k < ncols; k++)
+        h += static_cast<int64_t>(values[k].capacity() + nulls[k].capacity() +
+                                  offsets[k].capacity() * 4);
+      return h;
+    };
+    for (size_t k = 0; k < ncols; k++) {
+      // never NULL, even for a chunk of empty strings; NULL values for
+      // a column to fetch or one not decoded
+      static const char kNoBytes = 0;
+      if (!cols[k].active || cols[k].width > 0) {
+        out[k] = DatafusionPaxColumn{nullptr, nullptr, nullptr};
+        continue;
+      }
+      out[k].values = values[k].empty() ? &kNoBytes : values[k].data();
+      out[k].nulls = nulls[k].data();
+      out[k].offsets = offsets[k].data();
+    }
+    ledger.Set(base + held());
+    Chunk chunk{&cols, &values, &nulls, &keep, all_kept, j0, j1,
+                index, g, &locs, &loc_nulls, err, errlen, false};
+    if (emit(ctx, static_cast<uint32_t>(j1 - j0), out.data(), FetchColumn,
+             &chunk) != 0) {
+      if (!chunk.failed) SetError(err, errlen, "PAX read", "the consumer stopped");
+      return -1;
+    }
+    ledger.Set(base + held());
+    j0 = j1;
+  }
+  return 0;
+}
+
+// The bytes a decoded group's columns 'colv' hold.
+int64_t DecodedBytes(const std::vector<pax::PaxColumn *> &colv) {
+  int64_t decoded = 0;
+  for (pax::PaxColumn *col : colv) {
+    if (col == nullptr) continue;
+    decoded += static_cast<int64_t>(col->GetBuffer().second);
+    if (col->GetBitmap())
+      decoded += static_cast<int64_t>(col->GetBitmap()->Raw().size);
+  }
+  return decoded;
+}
+
+// A locator holds the block in bits 40-62, the group in bits 24-39 and the
+// row of the group in bits 0-23 (DATAFUSION_PAX_LOCATOR).
+constexpr int64_t kLocatorBlocks = int64_t{1} << 23;
+constexpr int64_t kLocatorGroups = int64_t{1} << 16;
+constexpr int64_t kLocatorRows = int64_t{1} << 24;
+
+int ReadBlock(void *scan_arg, int index, int first, int count,
+              DatafusionPaxEmit emit, DatafusionPaxAccount account, void *ctx,
+              char *err, size_t errlen) {
+  auto scan = static_cast<DfScan *>(scan_arg);
+  try {
+    // Declared first, so that it is destroyed last: everything it counts is
+    // freed by then.
+    Ledger ledger(account, ctx);
+    const DfBlock &block = scan->blocks.at(index);
+    auto fs = pax::Singleton<pax::LocalFileSystem>::GetInstance();
+    const size_t ncols = scan->cols.size();
+    const bool locators =
+        std::find(scan->late.begin(), scan->late.end(), true) != scan->late.end();
+
+    // the late columns are left to read_rows
+    std::vector<bool> proj(scan->natts, false);
+    for (size_t k = 0; k < ncols; k++)
+      if (!scan->late[k]) proj[scan->cols[k]] = true;
+    proj[scan->read_col] = true;
+    std::vector<int> projected;
+    for (int c = 0; c < scan->natts; c++)
+      if (proj[c]) projected.push_back(c);
+
+    int64_t visimap_bytes = 0;
+    std::shared_ptr<pax::Bitmap8> visimap;
+    if (!block.visimap.empty()) {
+      auto file = fs->Open(block.visimap, pax::fs::kReadMode);
+      auto len = file->FileLength();
+      visimap = std::make_shared<pax::Bitmap8>(len * 8);
+      file->ReadN(visimap->Raw().bitmap, len);
+      file->Close();
+      visimap_bytes = static_cast<int64_t>(len);
+    }
+
+    auto read_buffer =
+        std::make_shared<pax::DataBuffer<char>>(scan->read_buffer_size);
+    auto reader = OpenReader(block, std::move(proj), read_buffer);
+
+    // The block's groups to read are numbered 0 .. ngroups - 1; this call
+    // reads 'count' of them from 'first' (all from there if count < 0).
+    const size_t ngroups =
+        block.all_groups ? reader->GetGroupNums() : block.groups.size();
+    const size_t from = std::min(static_cast<size_t>(std::max(first, 0)), ngroups);
+    const size_t to =
+        count < 0 ? ngroups : std::min(from + static_cast<size_t>(count), ngroups);
+    for (size_t n = from; n < to; n++) {
+      const size_t g = block.all_groups ? n : block.groups[n];
+      auto group = reader->ReadGroup(g);
+      auto &columns = *group->GetAllColumns();
+      const size_t rows = group->GetRows();
+      const size_t offset = group->GetRowOffset();
+      if (locators && (index >= kLocatorBlocks || static_cast<int64_t>(g) >= kLocatorGroups ||
+                       static_cast<int64_t>(rows) > kLocatorRows)) {
+        SetError(err, errlen, "PAX read", "block, group or row beyond a row locator");
+        return -1;
+      }
+
+      std::vector<pax::PaxColumn *> colv(ncols, nullptr);
+      for (size_t k = 0; k < ncols; k++) {
+        if (scan->late[k]) continue;
+        colv[k] = columns[scan->cols[k]].get();
+        if (colv[k] == nullptr) {
+          SetError(err, errlen, "PAX read", "projected column missing");
+          return -1;
+        }
+      }
+      std::vector<pax::PaxColumn *> decoded_cols;
+      for (int c : projected) decoded_cols.push_back(columns[c].get());
+      const int64_t decoded = DecodedBytes(decoded_cols);
+      const int64_t base = visimap_bytes +
+                           static_cast<int64_t>(read_buffer->Capacity()) +
+                           decoded;
+      ledger.Set(base);
+
+      // Rows deleted in the visibility map are left out: 'keep' lists the
+      // others when any is deleted.
+      std::vector<uint32_t> keep;
+      bool all_kept = true;
+      if (visimap) {
+        size_t r = 0;
+        while (r < rows && !visimap->Test(static_cast<uint32>(offset + r))) r++;
+        if (r < rows) {
+          all_kept = false;
+          keep.reserve(rows);
+          for (size_t i = 0; i < rows; i++)
+            if (!visimap->Test(static_cast<uint32>(offset + i)))
+              keep.push_back(static_cast<uint32_t>(i));
+        }
+      }
+      if (EmitGroup(scan, index, static_cast<uint32_t>(g), colv, rows, keep,
+                    all_kept, ledger, base, emit, ctx, err, errlen) != 0)
+        return -1;
+    }
+    reader->Close();
+    return 0;
+  } catch (cbdb::CException &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.What().c_str());
+  } catch (std::exception &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.what());
+  } catch (...) {
+    SetError(err, errlen, "cannot read PAX micro-partition", "unknown error");
+  }
+  return -1;
+}
+
+int Late(void *scan_arg, const int *ks, int nks, char *err, size_t errlen) {
+  auto scan = static_cast<DfScan *>(scan_arg);
+  for (int i = 0; i < nks; i++) {
+    if (ks[i] < 0 || static_cast<size_t>(ks[i]) >= scan->cols.size()) {
+      SetError(err, errlen, "PAX late columns", "no such column");
+      return -1;
+    }
+    scan->late[ks[i]] = true;
+  }
+  // a column still decoded when none is handed out
+  for (size_t k = 0; k < scan->cols.size(); k++)
+    if (!scan->late[k]) {
+      scan->read_col = scan->cols[k];
+      break;
+    }
+  return 0;
+}
+
+int ReadRows(void *scan_arg, int index, int group_no, const uint32_t *rows,
+             uint32_t nrows, DatafusionPaxEmit emit, DatafusionPaxAccount account,
+             void *ctx, char *err, size_t errlen) {
+  auto scan = static_cast<DfScan *>(scan_arg);
+  try {
+    Ledger ledger(account, ctx);
+    const DfBlock &block = scan->blocks.at(index);
+    const size_t ncols = scan->cols.size();
+    std::vector<bool> proj(scan->natts, false);
+    bool any = false;
+    for (size_t k = 0; k < ncols; k++)
+      if (scan->late[k]) {
+        proj[scan->cols[k]] = true;
+        any = true;
+      }
+    if (!any) {
+      SetError(err, errlen, "PAX read", "no late column to read");
+      return -1;
+    }
+    auto read_buffer =
+        std::make_shared<pax::DataBuffer<char>>(scan->read_buffer_size);
+    auto reader = OpenReader(block, std::move(proj), read_buffer);
+    if (group_no < 0 || static_cast<size_t>(group_no) >= reader->GetGroupNums()) {
+      SetError(err, errlen, "PAX read", "no such group");
+      return -1;
+    }
+    auto group = reader->ReadGroup(static_cast<size_t>(group_no));
+    auto &columns = *group->GetAllColumns();
+    const size_t nrows_group = group->GetRows();
+    std::vector<uint32_t> keep(rows, rows + nrows);
+    for (uint32_t i = 0; i < nrows; i++)
+      if (keep[i] >= nrows_group || (i > 0 && keep[i] <= keep[i - 1])) {
+        SetError(err, errlen, "PAX read", "rows not ascending within the group");
+        return -1;
+      }
+    std::vector<pax::PaxColumn *> colv(ncols, nullptr);
+    for (size_t k = 0; k < ncols; k++) {
+      if (!scan->late[k]) continue;
+      colv[k] = columns[scan->cols[k]].get();
+      if (colv[k] == nullptr) {
+        SetError(err, errlen, "PAX read", "projected column missing");
+        return -1;
+      }
+    }
+    const int64_t base =
+        static_cast<int64_t>(read_buffer->Capacity()) + DecodedBytes(colv);
+    ledger.Set(base);
+    if (EmitGroup(scan, index, static_cast<uint32_t>(group_no), colv, nrows_group,
+                  keep, false, ledger, base, emit, ctx, err, errlen) != 0)
+      return -1;
+    reader->Close();
+    return 0;
+  } catch (cbdb::CException &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.What().c_str());
+  } catch (std::exception &e) {
+    SetError(err, errlen, "cannot read PAX micro-partition", e.what());
+  } catch (...) {
+    SetError(err, errlen, "cannot read PAX micro-partition", "unknown error");
+  }
+  return -1;
+}
+
+const DatafusionPaxScanApi kScanApi = {
+    DATAFUSION_PAX_SCAN_API_VERSION,
+    DF_PAX_BUILD_ID,
+    ScanBegin,
+    ScanNBlocks,
+    ScanInfo,
+    ReadBlock,
+    ScanEnd,
+    BlockGroups,
+    Late,
+    ReadRows,
+};
+
+}  // namespace
+
+extern "C" __attribute__((visibility("default"))) const DatafusionPaxScanApi *
+datafusion_pax_scan_api(void) {
+  return &kScanApi;
+}
