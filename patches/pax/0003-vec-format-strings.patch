+// Appends value i of vectorized-format string column 'st' to 'out';
+// false for a toasted value, which goes through GetDatum.
+inline bool AppendVecString(const ColState &st, size_t i, std::vector<char> &out,
+                            size_t *len) {
+  if (st.vec_str->IsToast(i)) return false;
+  auto b = st.vec_str->pax::PaxVecNonFixedColumn::GetBuffer(i);
+  out.insert(out.end(), b.first, b.first + b.second);
+  size_t n = b.second;
+  if (n < st.bpchar_n) {
+    out.insert(out.end(), st.bpchar_n - n, ' ');
+    n = st.bpchar_n;
   }
+  *len = n;
+  return true;
 }
 
