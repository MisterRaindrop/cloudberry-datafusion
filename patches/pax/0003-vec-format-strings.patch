+// Whether the 'len' bytes at 'p' are all ASCII, 8 at a time.
+inline bool AllAscii(const char *p, size_t len) {
+  size_t i = 0;
+  for (; i + 8 <= len; i += 8) {
+    uint64_t w;
+    memcpy(&w, p + i, 8);
+    if (w & 0x8080808080808080ULL) return false;
+  }
+  for (; i < len; i++)
+    if (static_cast<unsigned char>(p[i]) & 0x80) return false;
+  return true;
+}
+
+// Pads the char(n) value that starts at out[start] to 'chars' characters,
+// after cutting its trailing blanks (a blank never ends a character of
+// more than one byte); returns its bytes.  An ASCII value has as many
+// characters as bytes in every server encoding; pg_mbstrlen_with_len
+// counts the others, and only reads the database encoding.
+inline size_t PadBpChar(std::vector<char> &out, size_t start, size_t chars) {
+  size_t end = out.size();
+  while (end > start && out[end - 1] == ' ') end--;
+  out.resize(end);
+  const char *p = out.data() + start;
+  const size_t have =
+      AllAscii(p, end - start)
+          ? end - start
+          : static_cast<size_t>(
+                pg_mbstrlen_with_len(p, static_cast<int>(end - start)));
+  if (have < chars) out.insert(out.end(), chars - have, ' ');
+  return out.size() - start;
+}
+
+// Appends value i of vectorized-format string column 'st' to 'out';
+// false for a toasted value, which goes through GetDatum.
+inline bool AppendVecString(const ColState &st, size_t i, std::vector<char> &out,
+                            size_t *len) {
+  if (st.vec_str->IsToast(i)) return false;
+  auto b = st.vec_str->pax::PaxVecNonFixedColumn::GetBuffer(i);
+  const size_t start = out.size();
+  out.insert(out.end(), b.first, b.first + b.second);
+  if (st.bpchar_chars > 0) {
+    *len = PadBpChar(out, start, st.bpchar_chars);
+    return true;
+  }
+  size_t n = b.second;
+  if (n < st.bpchar_n) {
+    out.insert(out.end(), st.bpchar_n - n, ' ');
+    n = st.bpchar_n;
+  }
+  *len = n;
+  return true;
+}
