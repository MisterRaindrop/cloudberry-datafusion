-- gpdiff patterns for this extension's regression tests, used on top of the
-- defaults (see REGRESS_OPTS in the Makefile).

-- start_matchsubs

# Cloudberry appends the source location to internal errors (SQLSTATE XX000),
# e.g. "(df_init.c:64)".  Mask the line number so edits do not break tests.
m/\(df_\w+\.c:\d+\)/
s/\.c:\d+\)/.c:XXX)/

# An error raised on a segment names the segment, slice, address and pid.
m/\(seg\d+ slice\d+ [\d.]+:\d+ pid=\d+\)/
s/\(seg\d+ slice\d+ [\d.]+:\d+ pid=\d+\)/(segN sliceN host:port pid=N)/

# EXPLAIN ANALYZE figures of a DataFusion run vary from run to run.
m/^ DataFusion: \d+ partitions, memory limit \d+ kB, peak \d+ kB, spilled \d+ kB in \d+ files$/
s/^ DataFusion: \d+ partitions, memory limit \d+ kB, peak \d+ kB, spilled \d+ kB in \d+ files$/ DataFusion: # partitions, memory limit # kB, peak # kB, spilled # kB in # files/

-- end_matchsubs
